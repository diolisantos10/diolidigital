// ─── Foundation Sprint: Brain Pipeline Persistence ────────────────────────────

// DB-backed client request — source of truth for the real workflow.
// Zustand localStorage remains as labeled prototype/simulation layer.
model ClientRequestDb {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String   @id @default(cuid())
  workspaceId     String?
  clientId        String?
  businessName    String
  segment         String   @default("")
  // JSON-encoded string arrays
  services        String   @default("[]")
  objectives      String   @default("[]")
  status          String   @default("new")
  source          String   @default("briefing")
  rawContext      String   @default("")
  briefingJson    String?
  sdrHandoffJson  String?
  attachmentsJson String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// QUEM MANDOU ESTE BRIEFING, em forma comparável (16/08/2026).
  ///
  /// Pergunta do CEO: *"se entrar um cliente com o mesmo e-mail e fizer cinco
  /// briefings um atrás do outro, o que acontece com o sistema?"*. Acontecia
  /// que os cinco viravam cinco linhas anônimas: o contato mora dentro de
  /// `briefingJson`, que é um blob de texto, e **não dá para indexar nem
  /// agrupar por dentro de um JSON no SQLite**. Sem chave gravada, a caixa de
  /// entrada não tinha como dizer "esta é a 3ª vez que esta pessoa escreve".
  ///
  /// Derivada, nunca digitada — mesmo padrão de `Oportunidade.impressaoDigital`
  /// e `EmailDoRadar.mensagemId`. Quem calcula é
  /// `lib/agency/comercial/chave-do-prospect.ts`, a partir do contato
  /// DECLARADO: `email:<minúsculas>` de preferência, senão
  /// `whatsapp:<só dígitos>`.
  ///
  /// **Nula quando o briefing chegou sem canal** (`lead_incompleto`). Nulo aqui
  /// significa "esta linha não se junta a ninguém" — nunca "junta com as outras
  /// sem chave". Deduzir identidade de arroba de Instagram ou de nome de negócio
  /// é a inferência que esta casa proíbe.
  chaveDoProspect String?

  /// ── O AVISO DE ORÇAMENTO QUE FALHA NUNCA MAIS SOME (16/08/2026, aditiva) ──
  ///
  /// Motivo completo em `lib/agency/esteira/orcamento-do-briefing.ts`. Resumo:
  /// sem `RESEND_FROM` configurado no Railway, todo aviso de orçamento falha
  /// no dia do deploy — e até aqui a falha só existia como `console.warn`,
  /// apagado no redeploy seguinte. Estas três colunas dão à falha um lugar que
  /// SOBREVIVE à rodada, e que autoriza um reenvio sem duplicar o e-mail de
  /// quem já foi avisado com sucesso.
  ///
  /// Só são escritas DEPOIS que o orçamento já foi entregue no portal — mesma
  /// regra de `avisarPorEmail`: nunca antes da transação que tira o pedido de
  /// `new`. Os valores possíveis de `avisoOrcamentoStatus`, e cada um é um FATO
  /// diferente — nunca achatados em "deu certo" / "deu errado":
  ///   • "avisado"   — o e-mail saiu. O reenvio NUNCA busca este estado — é
  ///                   isso que impede o cliente de receber o orçamento 2x.
  ///   • "falhou"    — o Resend recusou o envio. É o que o reenvio busca.
  ///   • "skipped"   — `RESEND_API_KEY` ausente. Configuração da casa, não do
  ///                   pedido — mas reenviável assim que a chave existir, e por
  ///                   isso o reenvio também busca este estado.
  ///   • "sem_canal" — o lead não declarou e-mail. NÃO é falha, e o reenvio
  ///                   NUNCA busca este estado: não há para onde reenviar.
  ///
  /// E o quinto fato, que não é um valor gravado aqui — é a AUSÊNCIA dele:
  ///   • NULL — "não sabemos". `a2d06fb1` (versão anterior deste arquivo) já
  ///     estava em produção antes de esta coluna existir: todo pedido que o
  ///     relógio processou naquela janela saiu de `new` sem gravar nada.
  ///     NULL não é "falhou" (reenviar por padrão arriscaria duplicata para
  ///     quem, por acaso, já recebeu) nem "avisado" (garantiria silêncio para
  ///     quem não recebeu). Por isso vira um balde à parte — "legado"
  ///     (`contarAvisosLegados` / `reenviarAvisosLegados`) — nunca um sexto
  ///     valor gravado por palpite, e o reenvio dele é sempre opt-in
  ///     explícito, nunca o padrão. Ver "O BALDE DOS LEGADOS" em
  ///     `lib/agency/esteira/orcamento-do-briefing.ts`.
  avisoOrcamentoStatus     String?
  /// O motivo em texto — a resposta do Resend, ou "RESEND_API_KEY ausente".
  /// Nunca guarda dado do cliente: é sempre o lado da casa que falhou.
  avisoOrcamentoDetalhe    String?
  /// Quando este status foi gravado. Atualizada a cada tentativa — inclusive
  /// nos reenvios — para a fila de reenvio priorizar quem espera há mais tempo.
  avisoOrcamentoEm         DateTime?
  /// Quantas vezes a casa tentou avisar este pedido (entrega original +
  /// reenvios). Existe para o painel dizer "já tentamos 3x" em vez de deixar
  /// parecer que o reenvio nunca rodou.
  avisoOrcamentoTentativas Int      @default(0)

  artifacts     BrainArtifact[]
  approvals     ApprovalRequest[]
  evidenceItems EvidenceItem[]
  portalAccess  PortalAccess[]
  messages      PortalMessage[]

  /// ⚠️ **NÃO-ÚNICO, e a escolha é deliberada — por DOIS motivos.**
  ///
  /// 1. **Seria uma prisão.** Um cliente PODE legitimamente mandar um segundo
  ///    briefing: outra campanha, outro produto. `@@unique` aqui faria o segundo
  ///    pedido real do cliente **falhar na gravação** — a agência recusaria
  ///    trabalho novo por causa de uma trava de higiene. Não duplicar CADASTRO
  ///    é o objetivo; bloquear PEDIDO nunca foi.
  /// 2. **Quebraria o deploy.** O banco é SQLite num volume do Railway com dados
  ///    de piloto vivos, e já existem briefings repetidos lá (a Camila Pereira
  ///    duplicada, 08/08/2026). `CREATE UNIQUE INDEX` sobre dado já duplicado
  ///    falha na migração e derruba a subida inteira.
  ///
  /// A dedup mora na aplicação, onde ela pode distinguir "reenviou" de "pediu
  /// outra coisa" — que é uma pergunta de negócio, não de restrição de coluna.
  @@index([workspaceId, chaveDoProspect])
}

// Client ↔ team conversation. A thread belongs to um CLIENTE — não a uma
// solicitação. authorRole distinguishes who wrote it; the read flags drive
// unread badges on each side.
model PortalMessage {
  /// Nulo para cliente criado DIRETO (sem briefing público) — MESMO par de
  /// chaves que o ApprovalRequest e o BrainArtifact já adotaram em 04/08/2026.
  /// Era obrigatório, e por isso o cliente-piloto (Foocci, criado direto) não
  /// conseguia MANDAR mensagem nenhuma: a rota devolvia 404 "No conversation
  /// thread for this token yet" e a bolha voltava para a caixa de texto para
  /// sempre. O CEO tentou falar com a agência pelo portal e não conseguiu.
  id              String           @id @default(cuid())
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  /// O dono quando não há solicitação. Sem FK, pelo mesmo motivo do
  /// ApprovalRequest: a limpeza total (`/api/admin/reset`) já apaga a tabela
  /// inteira, e um FK novo redefiniria a tabela para todo mundo.
  ///
  /// A partir daqui TODA mensagem nova carimba o clientId quando ele é
  /// derivável — inclusive as que também têm clientRequestId. É o que mantém a
  /// conversa ÚNICA por cliente mesmo depois de o cliente ganhar (ou trocar de)
  /// solicitação: a leitura une as duas chaves.
  clientId        String?
  authorRole      String // "client" | "team"
  authorName      String           @default("")
  body            String
  readByTeam      Boolean          @default(false)
  readByClient    Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([clientRequestId, createdAt])
  @@index([clientId, createdAt])
  /// A caixa de entrada da agência conta por aqui: quantas do cliente ainda não
  /// foram lidas pela equipe. Escrito em 11 lugares e, até 05/08/2026, lido em
  /// NENHUM — a mensagem gravava e morria.
  @@index([readByTeam, authorRole])
}

// A planned/scheduled social post — the unit of the universal Planner. One post
// composed once, targeting many networks, scheduled to a date. Surfaces on the
// agency planner (edit) and the client portal Social tab (read-only calendar).
model SocialPost {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String    @id @default(cuid())
  workspaceId     String
  clientId        String?
  clientRequestId String? // links it to the client's portal thread
  caption         String    @default("")
  networks        String    @default("[]") // JSON array: instagram|facebook|tiktok|linkedin|youtube|pinterest
  format          String    @default("feed") // feed|reel|story|carousel|video
  pillar          String? // content pillar
  mediaUrl        String? // link to the creative (Drive/etc.) until native storage
  /// As telas do CARROSSEL, em JSON. Uma peça só com várias imagens — por isso
  /// não cabe em `mediaUrl`. Fica vazio em todo formato que não é carrossel.
  mediaUrlsJson   String  @default("[]")
  /// As telas descritas pelo especialista, uma por linha. É o que o gerador de
  /// arte usa para desenhar CADA tela — sem isso, um carrossel de 5 imagens
  /// sairia com 5 variações da mesma cena.
  scenesJson      String  @default("[]")
  /// A DIREÇÃO DE ARTE desta peça — o que a IMAGEM tem de mostrar.
  ///
  /// Escrita pelo especialista de copy no campo `visual` ("o que aparece na
  /// imagem", `especialistas.ts`), gravada no markdown do entregável como
  /// "- Visual: ..." (`run-execution.ts`) e, até 15/08/2026, **descartada ali**:
  /// `extrairPecas` não a lia e não havia coluna para guardá-la. O gerador de
  /// imagem recebia a LEGENDA como "Cena a retratar" — legenda de Instagram,
  /// com CTA e hashtag — e o desenho genérico era a saída coerente com o pedido.
  ///
  /// ⚠️ **Este campo NUNCA vira letra na peça.** O que vira pixel tem de ser
  /// trecho literal de `caption` (`travaDeTextoNaArte`, com `fonteAuditada =
  /// post.caption`). A direção de arte não passa pelo piso de verdade: ela
  /// descreve uma cena, não afirma um fato — e por isso só pode alimentar o
  /// PROMPT da imagem, nunca a camada de texto. Há teste de fonte que reprova
  /// quem a passar como `fonteAuditada`, `titulo`, `apoio` ou `selo`.
  ///
  /// Nulo = peça anterior a 15/08/2026, ou entrega cujo especialista não
  /// declarou o visual. Nulo cai no fallback (a legenda), que é o comportamento
  /// de sempre — é ele que torna a mudança reversível.
  artDirection    String?
  scriptJson      String? // AI video/reel script (hook, scenes, cta, audio)
  /// Contrato de visibilidade do Hub. Nasce "interno" (fail-closed); o fluxo
  /// que agenda para o calendário do cliente (esteira/publicacao.ts) grava
  /// "compartilhado" explicitamente. A rota do portal filtra por este campo —
  /// a lição da auditoria: rota nova escrita sem cuidado não pode vazar por padrão.
  visibility      String    @default("interno")
  scheduledFor    DateTime?
  status          String    @default("draft") // draft|scheduled|approved|published|failed
  // Quem gerou esta peça (o `Deliverable`) — é a chave de idempotência do
  // agendamento: entrega que já virou calendário não vira de novo.
  deliverableId   String?
  // Preenchidos na publicação. `externalPostId` é o que o relatório mensal usa
  // para pedir métricas à Meta; sem ele o report vira chute.
  externalPostId  String?
  permalink       String?
  publishedAt     DateTime?
  /// QUEM registrou a publicação. Mesma gramática do `ApprovalRequest.reviewedBy`,
  /// e pelo mesmo motivo: registro sem autor não é registro.
  ///   • `esteira`          — o relógio publicou sozinho (publicacao.ts);
  ///   • `equipe:<email>`   — alguém da casa postou À MÃO e veio marcar aqui.
  /// Nulo = peça anterior a 14/08/2026, quando o campo passou a existir. Nulo
  /// NÃO quer dizer "publicou sozinho" — quer dizer "não sabemos", e as duas
  /// coisas não podem virar a mesma no relatório.
  publishedBy     String?
  // Último motivo de falha, em linguagem de gente. Fica visível ao time em vez
  // de morrer no log do servidor.
  lastError       String?
  /// A PARADA DESTA PEÇA, NAS PALAVRAS QUE O CLIENTE LÊ (25/08/2026).
  ///
  /// `lastError` é para o TIME e é técnico. Este campo é para o CLIENTE, e ele
  /// existe porque a 5ª auditoria mediu o buraco: o ajuste refez o TEXTO, a
  /// arte não saiu, e a tela do cliente mostrou a legenda NOVA sobre a imagem
  /// que ele acabara de recusar. A frase honesta existia — mas só na aba de
  /// mensagens e no log. Ele varreu o HTML da tela de decisão: zero ocorrências
  /// de "não consegui", "não foi possível", "equipe", "erro", "problema".
  ///
  /// Regra: quem escreve aqui escreve MOTIVO, DONO e PRÓXIMA AÇÃO (critério F),
  /// em português de gente. `montarPecas` leva ao portal e `PecaDoCard` põe na
  /// tela, ACIMA da imagem — antes de o cliente decidir, nunca depois.
  ///
  /// Nulo = a peça não está parada. Quem resolve a parada LIMPA o campo: aviso
  /// que sobrevive ao conserto vira ruído, e ruído ninguém lê.
  avisoAoCliente  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, scheduledFor])
  @@index([deliverableId])
  @@index([status, scheduledFor])
  @@index([clientRequestId])
}

// One record per department approval — persists canvas payload + gate + trace.
model BrainArtifact {
  id                String           @id @default(cuid())
  /// Nulo para cliente criado DIRETO (sem briefing público) — mesmo par de
  /// chaves do SocialPost e do ApprovalRequest. Era obrigatório, e por isso a
  /// memória de LEITURA DO FEED (department "leitura-do-cliente") não tinha
  /// onde nascer justamente no cliente-piloto: post direto tem clientId e
  /// clientRequestId NULO, então a síntese nunca era gravada nem lida e o
  /// estilo do feed voltava vazio em silêncio.
  clientRequestId   String?
  clientRequest     ClientRequestDb? @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  /// O dono quando não há solicitação. Sem FK, pelo mesmo motivo do
  /// ApprovalRequest: a limpeza total (`/api/admin/reset`) já apaga a tabela
  /// inteira, e um FK novo redefiniria a tabela para todo mundo.
  clientId          String?
  department        String
  canvasId          String
  canvasJson        String
  qualityGateJson   String?
  cognitiveFlowJson String?
  version           Int             @default(1)
  status            String          @default("approved")
  approvedAt        DateTime        @default(now())
  approvedBy        String           @default("internal")
  createdAt         DateTime         @default(now())

  @@index([clientId, department])
}

// Formal approval flow — one record per department review cycle.
model ApprovalRequest {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String          @id @default(cuid())
  /// Nulo para cliente criado DIRETO (sem briefing público). No lançamento da
  /// Foocci (03/08/2026) TODA aprovação exigia ClientRequestDb — cliente direto
  /// não tinha como aprovar nada: o portal dizia "Esperando você" e a aba de
  /// Aprovações ficava vazia. A posse passa a ser: clientRequestId OU clientId.
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  /// O dono quando não há solicitação — mesmo par de chaves do SocialPost.
  /// Nunca vem de query/corpo no caminho público: deriva do token (regra da
  /// casa, 03/08/2026).
  clientId        String?
  artifactId      String?
  department      String
  requestedBy     String          @default("internal")
  status          String          @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  /// A dúvida do cliente NÃO é decisão (Fase 2, caminho C): o status continua
  /// "pending", mas o relógio do prazo não pode correr contra ele enquanto a
  /// bola está com a agência. Preenchido = dúvida aberta, prazo pausado; a
  /// resposta da agência devolve o tempo pausado ao `expiresAt` e limpa o campo
  /// (approval-service.addApprovalComment).
  questionOpenedAt DateTime?
  reviewNote      String?
  clientVisible   Boolean         @default(false)
  /// QUAL versão está sendo decidida — "aprovei a v3" não era registrável
  /// (Fase 1, 1.10) e o cliente podia aprovar lendo conteúdo de outra entrega
  /// (achado A2). O vínculo por FK mata o casamento heurístico por ordem.
  deliverableVersionId String?
  deliverableVersion   DeliverableVersion? @relation(fields: [deliverableVersionId], references: [id])
  /// Posts do calendário que ESTE card decide (JSON de ids de SocialPost).
  /// Preenchido = a origem é o calendário (rota /api/social-posts/aprovacao);
  /// a decisão do cliente propaga o status a estes posts (aprovar → "approved",
  /// ajuste/recusa → "revision_requested"). Vazio = aprovação do fluxo Brain.
  sourcePostIdsJson String        @default("[]")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments ApprovalComment[]

  @@index([clientId])
}

model ApprovalComment {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  authorName        String
  authorRole        String          @default("internal")
  /// "comment" | "question" | "answer". A dúvida fica PRESA ao card (Fase 2,
  /// caminho C) — não numa thread geral desconectada, que era o problema.
  kind              String          @default("comment")
  body              String
  isClientVisible   Boolean         @default(false)
  createdAt         DateTime        @default(now())
}

// Evidence items tied to a request or artifact — persisted to DB.
model EvidenceItem {
  id              String           @id @default(cuid())
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id])
  artifactId      String?
  department      String
  type            String
  label           String
  valueJson       String           @default("{}")
  sourceUrl       String?
  createdAt       DateTime         @default(now())
}

// ─── Meta (Instagram / Facebook / WhatsApp) connected accounts ──────────────────
// One row per connected asset (an IG business account, a FB page, or a WhatsApp
// number). Populated by the OAuth flow in app/api/meta/*. The long-lived access
// token is AES-256-GCM encrypted at rest (see lib/security/crypto.ts) — exactly
// like AI keys in DbIntegrationConfig. The Meta APP credentials (App ID / App
// Secret) live in DbIntegrationConfig (integrationId "int-meta"), NOT here.
model MetaConnection {
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional: a connection can belong to a specific client, or to the agency
  // itself (clientId null = the agency's own accounts).
  clientId             String?
  // instagram | facebook | whatsapp
  platform             String
  // Human-readable label: IG handle, Page name, or WhatsApp display name.
  name                 String          @default("")
  // The platform's native id: IG Business Account id, FB Page id, or WABA
  // phone-number id — the id the Graph API publish/insights calls target.
  externalId           String
  // Long-lived access token — ENCRYPTED (iv:tag:ciphertext). Page tokens for
  // FB/IG do not expire; user tokens last ~60 days (see tokenExpiresAt).
  accessTokenEncrypted String
  tokenHint            String?
  tokenExpiresAt       DateTime?
  // Granted scopes/permissions (JSON array) and any extra platform metadata
  // (e.g. linked page id, business id) as JSON — avoids new columns per field.
  scopes               String          @default("[]")
  metaJson             String          @default("{}")
  status               String          @default("connected") // connected | expired | revoked | error
  connectedAt          DateTime        @default(now())
  lastSyncedAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, platform])
  @@index([clientId])
  /// ⚠️ TODO WEBHOOK DE WHATSAPP PASSA POR AQUI.
  /// `resolveWorkspaceForPhone` (`lib/integrations/meta/inbox.ts:14`) procura
  /// por `{ platform, externalId }` — sem workspace, porque é justamente o
  /// workspace que ele está tentando descobrir. O `@@unique` acima começa por
  /// `workspaceId`, então não serve para esta busca: cada mensagem recebida
  /// varria a tabela.
  @@index([platform, externalId])
}

/// COTA POR PONTUAÇÃO DA MARKETING API — o contador que precisa ATRAVESSAR
/// réplica e deploy.
///
/// A Marketing API não limita por "chamadas por hora": limita por PONTUAÇÃO,
/// por CONTA DE ANÚNCIOS, com decaimento de 300 segundos — leitura vale 1
/// ponto, escrita vale 3, e o teto no nível de desenvolvimento é 60. Ou seja,
/// 20 escritas bloqueiam a conta por 5 minutos (fonte capturada:
/// docs/plataformas/meta/fontes/marketing-api-limites-de-taxa.md, 06/08/2026).
///
/// Até 06/08/2026 esse contador era um Map em MEMÓRIA: com N réplicas o teto
/// real virava N × teto, e todo deploy zerava. Como o que a Meta restringiu em
/// 03/08/2026 foi uma CONTA — não um processo —, o contador passou a morar
/// aqui. Uma linha por (conta, janela de 300s), incrementada por um único
/// UPDATE condicional (atômico).
model MetaAdCota {
  /// "<contaId>:<janela>" — determinístico de propósito: duas réplicas que
  /// tentam criar a mesma linha colidem na chave em vez de criar duas.
  id           String   @id
  /// "act_..." — o eixo em que a Meta conta.
  contaId      String
  /// floor(epoch_segundos / 300).
  janela       Int
  pontos       Int      @default(0)
  atualizadoEm DateTime @default(now())

  @@unique([contaId, janela])
  @@index([janela])
}

/// A SÉRIE DA MEDIÇÃO — o passado mínimo para saber que um evento PAROU.
///
/// 24/08/2026. O detector de "parou de chegar" existia e não tinha o que
/// comparar: a casa lia o desempenho de um período e esquecia. Sem passado, um
/// evento de conversão que some produz um número menor e mais nada.
///
/// ── O QUE ESTA TABELA GUARDA, E O QUE ELA SE RECUSA A GUARDAR ─────────────
///
/// Guarda **os NOMES dos eventos que chegaram**, por campanha e por período. Só
/// isso. Não guarda quantidade, não guarda gasto, não guarda criativo, não
/// guarda nada de público. A razão é dura: série histórica é a desculpa mais
/// fácil do mundo para acumular dado de campanha de cliente sem necessidade, e
/// a pergunta que esta tabela existe para responder é binária — "o evento X
/// chegou neste período?". Nome basta. Quantidade não acrescenta nada à
/// pergunta e acrescenta tudo ao estrago de um vazamento.
model MedicaoDeEventos {
  /// "<campanhaId>:<desde>:<ate>" — determinístico de propósito: duas réplicas
  /// que gravam a mesma leitura colidem na chave em vez de criar duas linhas.
  id         String   @id
  campanhaId String
  /// "act_..." — para poder apagar a série inteira de uma conta de uma vez.
  contaId    String
  /// AAAA-MM-DD, as bordas do período lido.
  desde      String
  ate        String
  /// Os nomes, separados por vírgula, em ordem. Vazio = a fonte respondeu e não
  /// veio evento nenhum — diferente de linha ausente, que é "nunca li".
  eventos    String   @default("")
  lidoEm     DateTime @default(now())

  @@unique([campanhaId, desde, ate])
  @@index([campanhaId, ate])
  @@index([contaId])
}

/// O CASTIGO DA CONTA depois de um erro de limite da Meta.
///
/// A Meta publica o tamanho do bloqueio (300s no nível de desenvolvimento, 60s
/// no acesso total). Enquanto durar, a casa não chama — e o freio no banco vale
/// para todas as réplicas e sobrevive ao deploy, ao contrário do balde em
/// memória de `lib/integrations/meta/ritmo.ts`.
model MetaAdFreio {
  contaId  String   @id
  ate      DateTime
  motivo   String   @default("")
  criadoEm DateTime @default(now())
}

/// O TETO POR HORA DE **TODA** A GRAPH — Instagram, Páginas, WhatsApp inclusive.
///
/// Irmão do `MetaAdCota` (que é só da Marketing API, e conta por pontuação). Até
/// 06/08/2026 este era o último contador de ritmo em MEMÓRIA de processo, em
/// dois lugares: `lib/integrations/meta/ritmo.ts` (marcas de tempo por chave) e
/// `lib/integrations/meta/leitura.ts` (mapa por conexão). Os dois defeitos são o
/// mesmo: todo deploy zerava — nesta casa, várias vezes por dia — e com N
/// réplicas o teto efetivo na MESMA conta da Meta virava N × teto.
///
/// `chave` é o ator, nunca o token: impressão digital FNV-1a (`tk:xxxxxxxx`),
/// `conexao:<id>` ou `escopo:<nome>`. Credencial não entra em tabela nem em log.
model MetaRitmoJanela {
  /// "<chave>:<janela>" — determinístico: duas réplicas colidem na chave
  /// primária em vez de criar duas linhas para a mesma hora.
  id           String   @id
  chave        String
  /// floor(epoch_segundos / 3600).
  janela       Int
  gastas       Int      @default(0)
  atualizadoEm DateTime @default(now())

  @@unique([chave, janela])
  @@index([janela])
}

/// O CASTIGO DA CHAVE depois de um erro de limite (ou de um cabeçalho de uso no
/// vermelho). Enquanto durar, a casa não chama a Meta com aquela chave.
///
/// Em memória, um redeploy no meio do castigo devolvia a rajada — e a Meta não
/// esquece a rajada. Só ESTENDE: um freio menor nunca encurta um maior.
model MetaRitmoFreio {
  chave    String   @id
  ate      DateTime
  motivo   String   @default("")
  criadoEm DateTime @default(now())

  @@index([ate])
}

/// O CACHE DE LEITURA DA META, no volume.
///
/// Não é histórico: é o que impede o dashboard aberto três vezes (ou a varredura
/// da esteira a cada 5 min) de virar três rajadas de GET na mesma conta. Em
/// memória, todo deploy o esvaziava e devolvia a primeira rajada de graça.
///
/// FAIL-OPEN por desenho: linha ausente ou ilegível é MISS, e a chamada segue
/// pelo contador (`MetaRitmoJanela`), que é a trava de verdade.
model MetaLeituraCache {
  /// "leitura:..." ou "desempenho:..." — o prefixo é o que permite limpar uma
  /// camada sem varrer a outra.
  chave     String   @id
  valorJson String
  validoAte DateTime
  criadoEm  DateTime @default(now())

  @@index([validoAte])
}

/// A LISTA EXPLÍCITA DO QUE A AGÊNCIA PODE LER/USAR NA META, POR CLIENTE.
///
/// Incidente de 06/08/2026: o CEO clicou "Conectar Facebook/Instagram" no
/// portal do cliente Foocci. A Meta devolveu um token de USUÁRIO dele, e o
/// sistema tratou "tudo o que o token ALCANÇA" como "tudo o que a agência PODE
/// LER": 14 contas de anúncio (Santioh, Dilix, Queise, DileeBags e contas
/// pessoais) e todas as Páginas/Instagram da conta pessoal dele — nada disso
/// tem relação com a Foocci, e nada disso foi autorizado.
///
/// ALCANCE ≠ AUTORIZAÇÃO. Esta tabela é o segundo conjunto, e ele é explícito:
/// uma linha por ativo que o CLIENTE marcou na tela dele. Ausência de linha é
/// NEGAÇÃO — nunca "ainda não configurado, então pode". Sem linha nenhuma, a
/// agência não lê nada daquele cliente.
model MetaAtivoAutorizado {
  /// "<workspaceId>:<clientId|agencia>:<tipo>:<externalId>" — determinístico de
  /// propósito: duas gravações do mesmo ativo colidem na chave em vez de criar
  /// duas linhas, e a chave é reconstruível por quem faz a pergunta.
  id            String   @id
  workspaceId   String
  /// null = a própria agência (o mesmo significado que em MetaConnection).
  clientId      String?
  /// ad_account | page | instagram | whatsapp
  tipo          String
  /// "act_123…" (conta de anúncio) | id da Página | id do IG Business | phone_number_id
  externalId    String
  nome          String   @default("")
  /// Quem marcou, para a revogação ter rastro: "portal:<clientId>" quando foi o
  /// próprio cliente na tela dele, "master:<userId>" quando foi a agência.
  autorizadoPor String   @default("")
  autorizadoEm  DateTime @default(now())

  @@index([workspaceId, clientId, tipo])
  @@index([workspaceId, tipo, externalId])
}

// WhatsApp conversation log — the single-inbox history. One row per message,
// inbound (client → agency) or outbound (agency → client), so the agency can
// read + reply from inside the system using ONE number. Populated inbound by
// the webhook and outbound by the reply endpoint.
model WhatsAppMessage {
  id              String   @id @default(cuid())
  workspaceId     String
  // The API phone-number-id this conversation belongs to (our number).
  phoneNumberId   String   @default("")
  // The client's WhatsApp id (their phone in wa_id form).
  contactWaId     String
  contactName     String?
  direction       String // "in" | "out"
  type            String   @default("text") // text | template | image | ...
  body            String   @default("")
  externalId      String? // Meta message id (wamid…) — for dedupe + status
  status          String? // sent | delivered | read | failed (outbound)
  clientRequestId String?
  timestamp       DateTime @default(now())

  @@index([workspaceId, contactWaId, timestamp])
  @@index([externalId])
}

// Outbox / dedupe ledger for WhatsApp notifications. One row per ActivityEvent
// we act on, so the poller never sends the same "whatsapp_notify" twice. Owned
// by the Meta integration (lib/integrations/meta/notifications.ts).
model WhatsAppOutbox {
  id                String   @id @default(cuid())
  workspaceId       String
  // The ActivityEvent this row was created for — unique so a re-run is a no-op.
  activityEventId   String   @unique
  kind              String   @default("proposal_sent")
  toPhone           String?
  status            String   @default("sent") // sent | failed | skipped
  externalMessageId String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, status])
}

// Granular, time-limited portal access per client request.
model PortalAccess {
  id              String           @id @default(cuid())
  token           String           @unique @default(cuid())
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id])
  clientId        String?
  grantedAt       DateTime         @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  accessCount     Int              @default(0)
  createdAt       DateTime         @default(now())

  /// `findFirst({ clientRequestId, revokedAt: null })` é a busca do link do
  /// portal — feita no caminho do aviso ao cliente.
  @@index([clientRequestId, revokedAt])
  @@index([clientId])
}

// ─── Radar Dioli — biblioteca viva de tendências/atualizações de mercado ────
// O acervo que abastece TODOS os agentes (insumo) e as diretrizes da Qualidade.
// Governança: fonte "official" (a própria plataforma — Meta/TikTok/Google) entra
// ATIVA sem validação; "trend" (não-oficial) entra PENDENTE até um humano aprovar.
model MarketInsight {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Domínio: social | design | paid-traffic | analytics | seo | general
  domain      String
  // Tópico — chave de versionamento: nova entrada do mesmo tópico arquiva a antiga
  // (o "era assim → agora é assim").
  topic       String
  title       String
  // A diretriz vigente ("agora é assim") — o insumo que os agentes usam.
  guidance    String
  // official = da própria plataforma → entra ATIVA sem validação humana.
  // trend    = não-oficial → entra PENDENTE até validação humana.
  source      String          @default("trend")
  sourceName  String?
  sourceUrl   String?
  // active | pending | archived | rejected
  status      String          @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, domain, status])
  @@index([workspaceId, topic])
}

// ─── Mídia ────────────────────────────────────────────────────────────────────

/// O ARQUIVO. Foi o buraco mais caro encontrado no raio-X de 02/08/2026: até
/// aqui, nenhum byte de mídia era gravado em lugar nenhum — nem de entrada
/// (o vídeo que o cliente manda) nem de saída (a arte que a IA gera).
///
/// O que isso quebrava, em três serviços de uma vez: a dona do salão não tinha
/// por onde mandar os vídeos dela; o pet shop não tinha por onde mandar o logo;
/// e a imagem gerada pelo Design virava base64 dentro de uma coluna de texto do
/// banco (megabytes por peça) ou uma URL da OpenAI que expira em ~1 hora.
///
/// Desenho: o BYTE mora no volume persistente do Railway — o mesmo que já
/// guarda o banco, e que o `scripts/start.sh` trata como armazenamento durável.
/// Aqui mora só o registro. Nenhuma coluna guarda conteúdo binário.
///
/// A segurança é por DERIVAÇÃO, não por comparação: o dono é gravado aqui, e a
/// rota de download resolve o dono a partir do token do portal — nunca da URL.
/// O caminho em disco é derivado do id, nunca do nome que o cliente enviou, o
/// que mata travessia de diretório por construção.
model MediaAsset {
  id              String   @id @default(cuid())
  workspaceId     String
  /// O dono. Um dos dois sempre presente — é o que a rota de download confere.
  clientRequestId String?
  clientId        String?
  projectId       String?
  /// inbound = o cliente mandou · generated = a IA produziu · deliverable = vai ao cliente
  kind            String   @default("inbound")
  /// Nome original. É PII em potencial ("orcamento-joao-silva.pdf") — fica aqui,
  /// nunca em log.
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Impressão digital do conteúdo: permite detectar reenvio do mesmo arquivo.
  sha256          String
  /// Caminho relativo dentro do diretório de mídia. Derivado do id, nunca do
  /// nome enviado.
  storagePath     String
  /// Quem enviou, em linguagem de gente ("cliente", "Agente de Design").
  uploadedBy      String   @default("cliente")
  createdAt       DateTime @default(now())

  @@index([clientRequestId, createdAt])
  @@index([workspaceId, kind])
  @@index([sha256])
}

// ─── Radar de oportunidades ───────────────────────────────────────────────────

/// A OPORTUNIDADE captada em marketplace de freelancer (99Freelas, Workana,
/// Upwork, Guru, PeoplePerHour, Freelancer.com).
///
/// DESENHO: o sistema NÃO navega em plataforma logada. Scraping de área logada é
/// o caminho mais curto para conta banida — a mesma lição que produziu a trava de
/// plataforma em 03/08/2026. A oportunidade entra por DUAS PORTAS, as duas de
/// texto puro:
///   (a) alguém COLA a URL/o texto do projeto no painel;
///   (b) o e-mail de alerta que a plataforma já manda é ENCAMINHADO para
///       `/api/agency/oportunidades/email`.
/// As duas caem na MESMA função de ingestão (`lib/agency/comercial/oportunidade.ts`).
///
/// ⚠️ `textoBruto` é DADO NÃO CONFIÁVEL. É texto escrito por um desconhecido na
/// internet. Ele descreve um pedido; ele NÃO dá ordem ao sistema. Nunca vai para
/// dentro de prompt como instrução, nunca vai para log (pode carregar contato de
/// terceiro — PII que não é nossa e que não pedimos).
model Oportunidade {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id          String @id @default(cuid())
  workspaceId String
  /// Slug canônico da origem: "99freelas" | "workana" | "upwork" | "guru" |
  /// "peopleperhour" | "freelancer" | "desconhecida".
  plataforma  String
  /// O link do projeto, QUANDO informado. Ausência de link não é erro — o
  /// e-mail de alerta de algumas plataformas não traz URL direta.
  urlExterna  String?

  titulo    String
  descricao String
  /// Só quando o texto declarar a categoria. Nunca inferida.
  categoria String?

  /// Orçamento em REAIS INTEIROS (1200 = R$ 1.200), nunca em centavos.
  /// A unidade está escrita aqui de propósito: `valorSugerido` usa a MESMA, e
  /// quem escrever a camada de negociação lê este comentário antes de comparar
  /// os dois. NULO quando o anúncio não declarou valor — ausência de informação
  /// não é informação.
  orcamentoInformado Int?
  /// O prazo COMO ESCRITO no anúncio ("15 dias", "até 20/08"). Texto, não data:
  /// converter "urgente" em um `DateTime` seria inventar o que o cliente não
  /// disse.
  prazoInformado     String?

  /// O texto original inteiro, como chegou. É a prova do que foi lido.
  textoBruto       String
  /// Hash do texto normalizado. É o que impede a MESMA oportunidade de entrar
  /// duas vezes quando alguém cola no painel o projeto cujo e-mail de alerta já
  /// tinha sido encaminhado — o caso normal, não o excepcional.
  impressaoDigital String

  /// Avaliação (0–100) e o porquê dela. Nulos até alguém/algo avaliar: o Radar
  /// ingere; quem pontua é outra etapa.
  nota            Int?
  servicoSugerido String?
  raciocinio      String?

  /// nova | aprovada | recusada | enviada — conjunto FECHADO, conferido na rota.
  status String @default("nova")

  /// A proposta redigida e o preço que vamos pedir (reais inteiros).
  /// ⚠️ `propostaTexto` NULO tem DOIS significados, e a tela precisa dos dois
  /// separados: "ainda não foi gerada" (`conformidadeOk` nulo) e "foi gerada e o
  /// Compliance Validator BARROU" (`conformidadeOk = false`). Colapsar os dois
  /// faria a tela pedir "analise de novo" para uma proposta que o portão
  /// reprovou — e a reanálise devolveria a mesma violação.
  propostaTexto String?
  valorSugerido Int?

  /// ─── O QUE O COMPLIANCE VALIDATOR DECIDIU (08/08/2026) ──────────────────
  /// Nulo = ninguém julgou ainda (oportunidade anterior a esta data, ou a IA
  /// não respondeu). `false` = julgou e REPROVOU — e aí `propostaTexto` é nulo
  /// de propósito, para não haver o que copiar.
  conformidadeOk Boolean?
  /// Os motivos da reprovação, em JSON: `[{regra,trecho,fonte}]`. É o que a tela
  /// mostra. Guardar só "reprovou" obrigaria o operador a adivinhar o quê.
  conformidadeAchados String?
  /// `true` quando o rascunho do modelo trazia link ou contato e o código tirou.
  /// Fica gravado porque apagar o erro sem contar esconde a reincidência do
  /// gerador — e é a reincidência que antecede a conta banida.
  propostaHigienizada Boolean?
  /// O retorno inteiro do Pricing Engine, em JSON: piso da casa, piso da
  /// categoria da plataforma, qual venceu, taxa e a oferta final que o cliente
  /// vê. A tela mostra DE ONDE o número veio; número sem procedência é palpite
  /// com cara de cálculo.
  precoDetalhe String?

  /// Quem bateu o martelo. `userId` da sessão, não e-mail: registro de decisão
  /// não precisa carregar identificador pessoal.
  decididoPor String?
  decididoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A trava da dedup. Por workspace, nunca global: dois inquilinos podem
  /// legitimamente estar olhando o MESMO projeto público.
  @@unique([workspaceId, impressaoDigital])
  /// A fila de triagem: "as novas deste workspace".
  @@index([workspaceId, status])
  /// A listagem ordena por nota desc e depois por data. Sem este índice, o
  /// SQLite varre a tabela e ordena em memória — e varredura aqui segura o
  /// único lock de escrita do banco inteiro.
  @@index([workspaceId, nota, createdAt])
  /// A segunda trava de dedup: o mesmo projeto chegando pelas duas portas com
  /// textos diferentes (e-mail em HTML × texto colado do site) só é reconhecido
  /// pelo LINK. Esta busca roda em TODA ingestão — sem índice, é varredura de
  /// tabela a cada oportunidade que entra.
  @@index([workspaceId, urlExterna])
}

// ─── O teto de ritmo que SOBREVIVE AO DEPLOY ─────────────────────────────────
//
// O contador de `lib/security/rate-limit.ts` mora na memória do processo. Isso
// tem duas consequências que o raio-x de 05/08/2026 nomeou: todo deploy ZERA os
// baldes, e uma segunda réplica multiplica o teto por N. É a mesma família da
// rota de imagem que já estava aberta e custou dinheiro — um teto que some é um
// teto que o atacante consegue rolar de graça (basta esperar o próximo deploy).
//
// Aqui o balde mora no VOLUME. A janela fixa é `(contagem, resetAt)`; a chave é
// `balde:identificador` (rota + IP, normalmente). Quem escreve é
// `lib/security/limite-no-banco.ts`, e a escrita é ATÔMICA por `updateMany`
// condicional — ler-e-depois-escrever deixa duas requisições simultâneas
// passarem pelo mesmo "9 de 10".
model RateLimitBucket {
  /// "rota:identificador". Chave primária de propósito: o `create` disputado
  /// entre duas requisições falha por unicidade, e a perdedora incrementa.
  chave     String   @id
  contagem  Int      @default(1)
  /// Fim da janela. Passou disso, a linha é RECICLADA (update), não apagada —
  /// reciclar não deixa buraco entre o DELETE e o INSERT.
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A faxina das janelas vencidas varre por `resetAt`.
  @@index([resetAt])
}

// ─── A ESCADA DE EXPOSIÇÃO — sombra → allowlist → wide ───────────────────────
//
// Por que no BANCO e não numa constante: a escada é o que decide se a saída de
// um departamento CHEGA ao cliente. Constante de código é editada por quem tem
// pressa e conferida por ninguém; e, pior, um `Record<string, Degrau>` no
// arquivo não tem como registrar QUEM subiu, QUANDO e COM QUAL NÚMERO. Sem essa
// prova, "subir de degrau" vira opinião com cara de configuração.
//
// Fail-closed: departamento SEM linha aqui é SOMBRA. A ausência da linha nunca
// pode significar "pode ir ao cliente" — é exatamente o defeito que as 31
// checagens tinham (silêncio = aprovado).
model DepartmentLadder {
  id           String @id @default(cuid())
  workspaceId  String
  /// O id do departamento (`lib/dioli-brain/departments.ts` + os que produzem
  /// em `lib/agency/execution/especialistas.ts`).
  departmentId String
  /// "sombra" | "allowlist" | "wide". Default fail-closed no próprio banco.
  degrau       String @default("sombra")
  /// JSON com os clientIds explicitamente liberados. SÓ tem efeito em
  /// "allowlist" — em "sombra" ninguém recebe, em "wide" todos recebem.
  clientesLiberados String @default("[]")
  /// Por que este departamento está neste degrau. Obrigatório na prática: um
  /// degrau sem motivo é um degrau que ninguém consegue auditar depois.
  motivo       String?
  /// Quem carimbou ("escada:semeadura", "escada:evidencia", "diretor", ...).
  decididoPor  String?
  /// O número que sustentou a ÚLTIMA subida — a prova congelada no instante em
  /// que ela valeu. Sem isto, "subiu com evidência" não é verificável a
  /// posteriori: a janela move e a evidência de ontem some.
  provaJson    String @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, departmentId])
}

/// Um registro por PEÇA que o departamento produziu — inclusive as barradas.
///
/// É o denominador da evidência. Contar só `Deliverable` mentiria a favor do
/// departamento: peça barrada no piso de verdade ou no contrato de saída NUNCA
/// vira `Deliverable`, então um departamento que inventa dado o tempo todo
/// apareceria com histórico limpo.
model DepartmentLadderRecord {
  id            String   @id @default(cuid())
  workspaceId   String
  departmentId  String
  projectId     String?
  clientId      String?
  deliverableId String?
  /// Em que degrau o departamento estava quando produziu. Guardado porque a
  /// evidência de SOMBRA é o que autoriza a subida — e ela precisa continuar
  /// legível depois que o degrau mudar.
  degrauNaEpoca String
  /// "aprovada" | "reprovada_qualidade" | "barrada_piso" | "barrada_contrato"
  /// | "sem_arbitro". `sem_arbitro` NÃO conta como aprovada: verde não é prova,
  /// e ausência de árbitro é ausência de informação.
  resultado     String
  detalhe       String?
  /// QUAL IA produziu esta peça. Acrescentado em 06/08/2026.
  ///
  /// É a ligação entre a escolha de provedor por cliente e a escada — e existe
  /// para NÃO haver um segundo mecanismo de maturidade. Provedor novo é
  /// exposição nova, e a casa já tem um jeito de medir exposição: contar peças
  /// aprovadas e reprovadas numa janela. Com esta coluna, "o gratuito aguenta o
  /// tráfego pago?" é uma consulta sobre a MESMA evidência que decide se a peça
  /// chega ao cliente, em vez de uma segunda escada paralela com regra própria.
  ///
  /// Nulo nos registros anteriores à coluna — e nulo aparece como "não sei",
  /// nunca somado ao provedor da casa.
  provedor      String?
  criadoEm      DateTime @default(now())

  @@index([workspaceId, departmentId, criadoEm])
}

// ─── O CONTADOR DE CONEXÕES DO 99FREELAS ─────────────────────────────────────
//
// Por que no BANCO e não num contador em memória: a cota é MENSAL e conexão
// gasta NÃO VOLTA. Um contador que mora no processo zera a cada deploy — e um
// teto que zera é um teto que não existe, exatamente o defeito que o raio-x de
// 05/08 nomeou no rate limit. Aqui cada gasto vira uma linha no volume.
//
// Uma linha por CONEXÃO GASTA, não por proposta: pergunta ao cliente também
// consome, e projeto disputado consome mais de uma. `custo` é o número LIDO DA
// TELA da plataforma — nunca inferido, nunca 1 por padrão.
model ConexaoGasta {
  id          String @id @default(cuid())
  workspaceId String
  /// Slug da plataforma. Hoje só "99freelas" tem cota de conexão, mas a coluna
  /// existe porque a segunda plataforma não pode exigir uma tabela nova.
  plataforma  String

  /// "2026-08" — o mês da cota, no fuso de São Paulo. A cota vira à meia-noite
  /// do CEO, não à do UTC; sem isto, três horas de todo dia 31 liberariam cota
  /// que ainda não existe.
  competencia String

  /// "proposta" | "pergunta". As duas gastam.
  motivo String
  /// Quantas conexões esta interação consumiu, LIDO DA TELA. A plataforma não
  /// publica a tabela ("varia com o quão disputado é"), então inferir aqui é
  /// inventar — e o erro só aparece quando a cota acaba no meio do mês.
  custo  Int

  /// A oportunidade correspondente, quando houver.
  oportunidadeId String?
  /// Quem confirmou o gasto. Enquanto o envio for HUMAN_GATE, é sempre gente.
  registradoPor  String

  criadoEm DateTime @default(now())

  /// A pergunta que a casa faz toda vez: quanto já gastei neste mês?
  @@index([workspaceId, plataforma, competencia])
  /// A trava contra contar duas vezes a mesma proposta. `oportunidadeId` nulo
  /// (perguntas avulsas) não colide: no SQLite, NULLs são distintos entre si.
  @@unique([workspaceId, plataforma, motivo, oportunidadeId])
}

// ─── O LIVRO DAS MENSAGENS JÁ LIDAS DA CAIXA DA AGÊNCIA ──────────────────────
//
// A terceira porta de entrada do Radar (08/08/2026): em vez de alguém
// ENCAMINHAR o alerta do 99Freelas para `/api/agency/oportunidades/email`, a
// casa LÊ a caixa da agência por IMAP e ingere sozinha.
//
// ── POR QUE ESTA TABELA EXISTE, E POR QUE ELA NÃO É "MAIS UM CAMPO NA
//    OPORTUNIDADE" ─────────────────────────────────────────────────────────
// Ela é o CURSOR da caixa, não um atributo da oportunidade. Guarda TODA
// mensagem examinada — inclusive a que NÃO virou oportunidade (remetente que
// não é da plataforma, corpo ilegível, ingestão que falhou). Um campo na
// `Oportunidade` só saberia registrar o caso feliz, e a rotina releria para
// sempre a mensagem que nunca vira nada.
//
// ── IDEMPOTÊNCIA EM DUAS CAMADAS, E NENHUMA SOZINHA BASTA ────────────────────
//   1. `@@unique([workspaceId, mensagemId])` — o `Message-ID` do e-mail, que é
//      o identificador que o remetente atribui e que sobrevive a re-download,
//      a mudança de UID e a re-indexação da caixa. É a trava de fora.
//   2. `Oportunidade.@@unique([workspaceId, impressaoDigital])` + a dedup por
//      link, que já existiam. É a trava de dentro.
// A ordem de gravação é: oportunidade PRIMEIRO, registro da mensagem DEPOIS.
// Um processo que morra entre as duas relê a mensagem na rodada seguinte e é
// barrado pela camada 2 — nunca cria a segunda linha. O contrário (registrar a
// mensagem antes) perderia a oportunidade em silêncio.
//
// ⚠️ UID **não** é identidade. O IMAP permite que o servidor invalide os UIDs
// da pasta inteira (`UIDVALIDITY`), e o Gmail o faz. Ele é guardado só como
// rastro operacional; a chave é o `Message-ID`.
model EmailDoRadar {
  id          String @id @default(cuid())
  workspaceId String

  /// O `Message-ID` do cabeçalho, COMO VEIO (com os `<>`, se vieram). É a
  /// chave da idempotência.
  /// ⚠️ Mensagem sem `Message-ID` existe — raríssima, mas existe. Nesse caso a
  /// rotina grava aqui um substituto derivado por hash do remetente + assunto +
  /// data + tamanho, prefixado por `sem-message-id:`, e o motivo diz isso. O que
  /// não pode acontecer é a chave ficar vazia: chave vazia colide com todas as
  /// outras mensagens sem `Message-ID` e engoliria alertas de verdade.
  mensagemId String

  /// O UID na pasta, no momento da leitura. Rastro operacional, nunca chave.
  uid Int?

  /// O remetente, minúsculo e sem nome de exibição ("naoresponda@99freelas.com.br").
  /// Guardado porque é o que responde "por que esta mensagem entrou?" — e é o
  /// dado que confirma (ou desmente) o filtro configurado.
  remetente String
  /// O assunto, cortado. É o que a tela mostra no histórico.
  assunto   String?

  /// A data do e-mail, quando o servidor a informou.
  recebidoEm   DateTime?
  processadoEm DateTime  @default(now())

  /// O que a rodada decidiu sobre esta mensagem. Conjunto FECHADO:
  ///   "oportunidade" — virou linha nova em `Oportunidade`;
  ///   "duplicada"    — a oportunidade já existia (dedup de dentro pegou);
  ///   "ignorada"     — remetente fora do filtro, ou corpo sem texto legível;
  ///   "falha"        — a ingestão quebrou. Fica gravado para NÃO ser relido em
  ///                    laço infinito, e o motivo aparece na tela.
  resultado String
  /// Por que, em uma frase. Nunca nulo quando `resultado` não é "oportunidade":
  /// mensagem descartada sem motivo é a mesma coisa que mensagem perdida.
  motivo    String?

  /// A oportunidade que nasceu (ou que já existia), quando houve uma.
  oportunidadeId String?

  /// ⚠️ O CORPO DO E-MAIL NÃO MORA AQUI. Ele já é gravado em
  /// `Oportunidade.textoBruto` quando vira oportunidade, e alerta de
  /// marketplace carrega contato de terceiro com frequência — PII que não
  /// pedimos. Duas cópias do mesmo texto é uma superfície de vazamento a mais
  /// sem nenhum leitor novo.

  /// A trava da idempotência. Por workspace, como toda dedup desta casa.
  @@unique([workspaceId, mensagemId])
  /// O histórico da tela: "as últimas mensagens que a rotina leu".
  @@index([workspaceId, processadoEm])
}


// ─── Medição da conta do cliente ──────────────────────────────────────────────
//
// O que a conta DELE já ensinou. Pedido do CEO em 09/08/2026: *"a agência
// precisa ter essa inteligência pra acertar na entrega, e não depender só dos
// arquivos dos clientes."*
//
// Uma linha por post por leitura. NÃO sobrescreve: o mesmo post medido em dois
// dias tem duas linhas, porque desempenho é curva e não fotografia — e
// sobrescrever apagaria justamente a diferença que interessa.

model MetricaDePost {
  id             String   @id @default(cuid())
  clientId       String
  /// O id do post NA PLATAFORMA. É por ele que a leitura casa com o que já foi
  /// publicado; sem ele a métrica não tem dono e não entra.
  externalPostId String
  plataforma     String   @default("instagram")
  /// Nulo = NÃO MEDIDO. Nunca zero: zero é um número que a plataforma devolveu,
  /// e "não medido" é a ausência dela — confundir os dois faz a agência
  /// declarar fracasso onde houve silêncio.
  alcance        Int?
  impressoes     Int?
  curtidas       Int?
  comentarios    Int?
  salvamentos    Int?
  compartilham   Int?
  cliques        Int?
  /// Quando a plataforma foi consultada.
  lidoEm         DateTime @default(now())
  /// De onde veio. `api` = lido da plataforma; `manual` = alguém digitou.
  /// Separado porque número digitado à mão não sustenta a mesma conclusão.
  origem         String   @default("api")

  @@index([clientId, externalPostId])
  @@index([clientId, lidoEm])
}

// ═══════════════════════════════════════════════════════════════════════════
// ARQUITETURA OPERACIONAL V2 — Marco 2 (núcleo canônico). TUDO ADITIVO.
// Fonte: docs/arquitetura-operacional-v2/ (aprovada pelo CEO em 15/08/2026).
// Nenhuma tabela legada é alterada aqui; a remoção de legado é etapa tardia,
// fora deste marco, e só com aprovação do CEO.
// ═══════════════════════════════════════════════════════════════════════════

/// Determinação do CEO: toda execução registra se foi humana ou por IA — com
/// ator, modelo, versão, custo, data e ferramentas. Complementa o AIRunLog
/// legado (que fica); o backfill do M3 liga os dois pelo correlationId.
model ExecucaoV2 {
  id             String    @id @default(cuid())
  /// "humano" | "ia" — validado em lib/agency/execucao-v2/registro.ts.
  ator           String
  usuarioId      String?
  modelo         String?
  versaoModelo   String?
  custoUsd       Float?
  funcaoId       String
  departamentoId String
  /// JSON: lista de ferramentas usadas (vazia quando nenhuma).
  ferramentas    String    @default("[]")
  correlationId  String
  inicio         DateTime  @default(now())
  fim            DateTime?
  resultado      String?
  /// Piloto assistido: de que cliente é este trabalho (null = interno).
  clienteId      String?
  /// JSON: as entradas efetivamente usadas (rastro completo da regra 6).
  entradas       String?

  @@index([correlationId])
  @@index([departamentoId, funcaoId])
  @@index([ator, inicio])
  @@index([clienteId, inicio])
}

/// AUDITORIA DE RECUSAS (piloto assistido): recusa sem rastro é recusa
/// invisível — cada "não" do motor fica registrado com motivo e contexto.
model RecusaV2 {
  id            String   @id @default(cuid())
  funcaoId      String
  motivo        String
  correlationId String
  clienteId     String?
  em            DateTime @default(now())

  @@index([funcaoId, em])
  @@index([correlationId])
}

/// Toda transição da máquina canônica deixa rastro: quem, quando, origem,
/// motivo, versão e correlação (princípio 9 da arquitetura mestra). A chave
/// de idempotência é ÚNICA: a mesma transição nunca acontece duas vezes.
model TransicaoDeEstado {
  id                String   @id @default(cuid())
  entidadeTipo      String
  entidadeId        String
  de                String
  para              String
  atorTipo          String
  atorId            String
  motivo            String
  origem            String
  versaoLida        Int
  chaveIdempotencia String   @unique
  correlationId     String
  criadoEm          DateTime @default(now())

  @@index([entidadeTipo, entidadeId, criadoEm])
  @@index([correlationId])
}

/// Bloqueio tipado (9 motivos canônicos): dono, SLA, evidência e próxima
/// ação. Falha não desaparece — ocupa espaço de propósito.
model BloqueioV2 {
  id               String    @id @default(cuid())
  entidadeTipo     String
  entidadeId       String
  /// Um dos 9 motivos de architecture.manifest.json → blockingReasons.
  tipo             String
  donoFuncaoId     String
  abertoEm         DateTime  @default(now())
  slaAte           DateTime?
  evidencia        String?
  acaoRecomendada  String
  escalonadoPara   String?
  resolvidoEm      DateTime?
  correlationId    String

  @@index([entidadeTipo, entidadeId, resolvidoEm])
  @@index([tipo, resolvidoEm])
}

/// Outbox de efeito externo: mensagem, webhook, publicação, aprovação.
/// Generaliza o padrão que o WhatsAppOutbox já provou. Efeito nunca roda
/// inline — entra aqui e o relógio processa com retentativa.
model OutboxV2 {
  id                 String    @id @default(cuid())
  tipo               String
  payload            String
  /// pending | sent | failed | dead
  status             String    @default("pending")
  tentativas         Int       @default(0)
  proximaTentativaEm DateTime  @default(now())
  chaveIdempotencia  String    @unique
  correlationId      String
  criadoEm           DateTime  @default(now())
  enviadoEm          DateTime?
  ultimoErro         String?

  @@index([status, proximaTentativaEm])
  @@index([correlationId])
}

/// Feature flags da migração V2. Desligar a flag = rollback de comportamento
/// sem tocar dado. Toda mudança de flag tem motivo e dono.
model FlagV2 {
  id         String   @id @default(cuid())
  chave      String
  /// "global" ou um workspaceId/clientId específico.
  escopo     String   @default("global")
  ligada     Boolean  @default(false)
  motivo     String
  decididoPor String
  em         DateTime @default(now())

  @@unique([chave, escopo])
}

/// Relatórios de leitura dupla (M3): derivado × legado, com amostra das
/// divergências. Divergência nunca vira exceção pro usuário — vira linha aqui.
model ReconciliacaoV2 {
  id           String   @id @default(cuid())
  entidadeTipo String
  execucaoEm   DateTime @default(now())
  total        Int
  divergentes  Int
  /// JSON: amostra das divergências (id, legado, derivado).
  amostra      String   @default("[]")
  veredito     String

  @@index([entidadeTipo, execucaoEm])
}

/// Prova de vida dos relógios (M6): relógio que não bate gera alerta —
/// ausência de alerta não é ausência de problema.
model HeartbeatDoRelogio {
  id           String   @id @default(cuid())
  relogio      String   @unique
  ultimaBatida DateTime @default(now())
  alertadoEm   DateTime?
}

/// V2 INTEGRAÇÃO — o contrato de handoff do 03, como tabela. ADITIVA.
/// Sem aceite do recebedor, a tarefa NÃO some da fila anterior: fica
/// "aguardando_recebimento" — é a regra literal da esteira integrada.
model HandoffV2 {
  id                 String    @id @default(cuid())
  deDepartamento     String
  paraDepartamento   String
  responsavelEntrega String
  responsavelRecebe  String?
  entrada            String
  saida              String
  versaoArtefato     String
  criterios          String
  prazoProximo       DateTime?
  bloqueios          String    @default("[]")
  correlationId      String
  /// aguardando_recebimento | aceito
  status             String    @default("aguardando_recebimento")
  criadoEm           DateTime  @default(now())
  aceitoEm           DateTime?
  /// Quando o PM cobrou este handoff parado. Sem esta marca, a varredura
  /// cobraria de novo a cada 5 minutos e o alerta viraria ruído.
  cobradoEm          DateTime?

  @@index([paraDepartamento, status])
  @@index([correlationId])
}

/// ─── A TESTEMUNHA DE QUE O DINHEIRO ENTROU (24/08/2026) ──────────────────────
///
/// Regra do CEO, literal: *"o cliente fecha um projeto com a gente, ele vai ter
/// que pagar antes de o projeto começar a ser feito. Eu vou pedir pra fazer um
/// bolo, e só pago o bolo quando o bolo está feito? Não — eu preciso do dinheiro
/// pra comprar os insumos. Então a trava é o pagamento."*
///
/// ── POR QUE UMA TABELA NOVA, e não uma coluna ou um estado existente ────────
///
/// Até hoje a casa não tinha NENHUM registro de pagamento. O que existia era
/// `ClientRequestDb.status = "in_progress"`, escrito pelo webhook do Mercado
/// Pago (`app/api/self-serve/webhook/route.ts`) — e escrito TAMBÉM por
/// `app/api/brain/orchestrate/apply/route.ts` e `app/api/v2/assistido/route.ts`,
/// que não têm nada a ver com dinheiro. Um estado que três caminhos escrevem,
/// dois deles sem cobrar nada, não é prova de pagamento: é uma palavra que por
/// acaso aparece nos dois lugares. Usá-lo como testemunha seria exatamente o
/// defeito que esta casa já viu — "não recusou" lido como "pagou".
///
/// `LancamentoFinanceiro` também não serve: ele é o DRE (regime de competência,
/// aceita `natureza: "estimado"` e `origem: "manual"` sem prova), e mexer nele
/// altera o que o CEO lê como resultado. Testemunha de portão e livro-caixa são
/// coisas diferentes.
///
/// Então: um registro PRÓPRIO, escrito por um caminho só, cuja EXISTÊNCIA é a
/// prova. Ausência de linha é ausência de prova — nunca "provavelmente pagou".
///
/// ADITIVA: tabela nova, nenhuma tabela existente é tocada. O banco é SQLite num
/// volume do Railway com dados de piloto VIVOS.
///
/// Rollback: DROP TABLE "PagamentoConfirmado". Sem a tabela, a leitura falha e
/// o portão RECUSA tudo que nasceu depois do corte — degrada para parado, nunca
/// para produzindo de graça.
model PagamentoConfirmado {
  id              String   @id @default(cuid())

  /// O PEDIDO que foi pago. É a mesma chave que o Mercado Pago carrega como
  /// `external_reference`, então o webhook não precisa traduzir nada.
  ///
  /// `@unique` de propósito: um pedido tem UM pagamento confirmado. Gateway
  /// reenvia webhook — o reenvio tem de cair no mesmo registro, nunca criar um
  /// segundo. A idempotência mora no banco, não numa variável em memória.
  clientRequestId String   @unique

  /// `mercadopago` — o webhook assinado do provedor, a testemunha primária.
  /// `manual`      — alguém da casa registrou um Pix/transferência recebido
  ///                 fora do gateway. Continua sendo um registro auditado, com
  ///                 dono (`registradoPor`) e valor — não é um checkbox.
  origem          String

  /// O id do pagamento no provedor. Nulo só quando `origem = "manual"`.
  provedorId      String?

  /// CENTAVOS, inteiro. Dinheiro em ponto flutuante é erro de arredondamento
  /// com nome de bug.
  ///
  /// ⚠️ OBRIGATÓRIO, e o portão exige `> 0`. Esta casa já leu "teto 0" como
  /// "sem limite" em outro produto. Aqui, zero centavos é ZERO — não é "valor
  /// não informado" e muito menos "liberado". Sem número, não há linha.
  valorCentavos   Int

  moeda           String   @default("BRL")

  /// Quando o dinheiro foi confirmado (o `date_approved` do provedor, ou o
  /// momento do registro manual).
  confirmadoEm    DateTime

  /// Quem registrou. NULO significa "o webhook do provedor" — e isso é um fato
  /// diferente de "não sabemos quem foi". Registro manual SEMPRE tem dono.
  registradoPor   String?

  /// Para o registro manual: o que foi recebido e por onde. Nunca guarda dado
  /// de cartão ou de conta — é texto do operador sobre a própria casa.
  observacao      String?

  createdAt       DateTime @default(now())

  @@index([confirmadoEm])
}

/// A TERCEIRA TESTEMUNHA: a parceria isenta de pagamento.
///
/// ─── POR QUE ELA É UMA TABELA PRÓPRIA, E NÃO UMA LINHA DE PAGAMENTO ─────────
///
/// O primeiro cliente real da agência (Foocci, 27/08/2026) entra por parceria:
/// não paga nada. E hoje ele TRAVA no portão de pagamento — e o portão está
/// certo.
///
/// A tentação era registrar um `PagamentoConfirmado` de R$ 0,00. Duas razões
/// para não fazer isso, e as duas são do CEO:
///   1. **Receita fantasma.** Uma linha de pagamento diz "entrou dinheiro". Não
///      entrou. O financeiro passaria a somar vendas que não existem.
///   2. **Destruiria a testemunha.** `PagamentoConfirmado` recusa valor ≤ 0 no
///      código E no portão, de propósito — é o que garante que toda linha ali
///      seja dinheiro de verdade. Furar isso para o parceiro fura para todos.
///
/// Então a isenção é OUTRO fato, com OUTRA tabela: ela libera a esteira sem
/// nunca afirmar que houve pagamento. *Parceria não é grátis — é investimento,
/// e investimento se mede.*
model IsencaoDeParceria {
  id              String   @id @default(cuid())

  /// O pedido isentado. `@unique` pelo mesmo motivo do pagamento: um pedido tem
  /// UMA isenção, e registrar de novo cai na mesma linha.
  clientRequestId String   @unique

  /// O cliente, quando derivável. Serve ao financeiro (a conta da parceria é
  /// por cliente, não por pedido).
  clientId        String?

  /// ⚠️ NOMINAL E OBRIGATÓRIO. **Isenção sem dono é buraco**: daqui a seis meses
  /// ninguém sabe quem liberou, e "sempre foi assim" vira a resposta.
  autorizadaPor   String

  /// ⚠️ OBRIGATÓRIA. **Parceria eterna vira esquecimento** — a casa segue
  /// produzindo de graça anos depois de a contrapartida ter acabado. Vencida, a
  /// isenção não libera mais nada e o pedido volta a travar no portão.
  validaAte       DateTime

  /// O que a parceria cobre: produtos/serviços, em texto do operador.
  escopo          String

  /// Quantas peças a parceria dá direito. Zero é ZERO — nunca "sem limite".
  pecasContratadas Int

  /// ⛔ O TETO DE CUSTO DE IA, EM CENTAVOS DE DÓLAR.
  ///
  /// Sem teto, o parceiro come o crédito do cliente pagante — e o crédito desta
  /// casa é finito e sem recarga automática. Zero é ZERO, não "liberado".
  tetoDeIaCentavosUsd Int

  observacao      String?
  createdAt       DateTime @default(now())

  @@index([validaAte])
}
