// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model AgencyWorkspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users                User[]
  clients              Client[]
  projects             Project[]
  integrationConfigs   DbIntegrationConfig[]
  clientAiProviders    ClientAiProvider[]
  activityEvents       ActivityEvent[]
  aiRunLogs            AIRunLog[]
  lancamentos          LancamentoFinanceiro[]
  metaConnections      MetaConnection[]
  marketInsights       MarketInsight[]
}

// ─── Users / Auth ─────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  // Roles: master | project_manager | social_staff | design_staff | ads_staff | client
  role         String          @default("master")
  workspaceId  String
  workspace    AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // For client users only — links to the Client they may access
  clientId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ─── Clients ──────────────────────────────────────────────────────────────────

model Client {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  email       String?
  phone       String?
  website     String?
  // Secure token for client portal access — replaces raw client ID in portal URL
  portalToken String          @unique @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projects        Project[]
  notices         ClientNotice[]
  brandBrain      BrandBrain?
  brandUpdates    BrandUpdate[]
  contentRequests ContentRequest[]

  /// Toda listagem de cliente é por inquilino. Sem isto, cada tela de clientes
  /// varre a tabela inteira — e numa SQLite em volume, varredura segura lock.
  @@index([workspaceId])

  /// A BUSCA QUE IMPEDE O CADASTRO HOMÔNIMO (16/08/2026).
  ///
  /// `resolverOuCriarCliente` procura por aqui antes de criar ficha nova —
  /// era a ausência dessa busca que fazia cinco briefings do mesmo e-mail
  /// virarem cinco `Client`, cinco portais e cinco históricos (a Camila Pereira
  /// duplicada em produção). O balcão (`balcao/producao.ts:97`) já fazia esta
  /// consulta desde sempre, sem índice.
  ///
  /// ⚠️ **NÃO-ÚNICO, de propósito.** `email` é opcional e há fichas duplicadas
  /// **agora** no volume de produção, esperando decisão de fusão do CEO:
  /// `CREATE UNIQUE INDEX` sobre elas falharia na migração e derrubaria o
  /// deploy. Além disso, `@@unique` não deixaria mais ninguém consertar dado
  /// legado sem antes fundir tudo à mão. A trava é na aplicação; aqui é só a
  /// velocidade da busca.
  @@index([workspaceId, email])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Links a project back to the Brain request it was created from, so the
  // execution view can load the approved department canvases (BrainArtifact).
  clientRequestId      String?
  name                 String
  goal                 String?
  type                 String?
  stage                String          @default("briefing")
  priority             String          @default("medium")
  deadline             String?
  proposalStatus       String?
  proposalPricing      String?
  proposalScope        String?
  proposalSentAt       String?
  // JSON-encoded string array of assigned agent IDs
  agents               String          @default("[]")
  // Execução durável da produção (não depende mais do navegador): o motor marca
  // o progresso no banco; um cron recupera projetos travados.
  // executionStatus: idle | pending | running | done | failed
  executionStatus      String          @default("idle")
  executionRequestedAt DateTime?
  executionStartedAt   DateTime?
  executionFinishedAt  DateTime?
  executionAttempts    Int             @default(0)
  executionError       String?

  // ── A ESTEIRA: os três carimbos que fazem o projeto andar ──────────────────
  // São DECISÕES, por isso ficam gravadas. O resto da fase é DERIVADO do dado
  // real (lib/agency/esteira/fases.ts) — campo de status escrito à mão mente em
  // duas semanas. Estes três não são status: são momentos que aconteceram.
  //
  // O portão de direção: a produção inteira só dispara depois que o cliente
  // avaliza o caminho. Aprovar direção é barato; refazer um mês de produção não.
  directionApprovedAt DateTime?
  // O PM apresentou o pacote de UMA vez. Antes disso o cliente não recebe
  // entrega solta — agência com cinco bocas parece desorganizada.
  presentedAt         DateTime?
  // O aval final do cliente. A partir daqui, implementação e ciclo mensal.
  clientApprovedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliverables     Deliverable[]
  materialRequests MaterialRequest[]
  strategyRooms    StrategyRoom[]
  activityEvents   ActivityEvent[]
  tasks            Task[]
  timelineEvents   TimelineEvent[]
  briefings        Briefing[]
  cycles           Cycle[]

  /// ⚠️ ESTE É O ÍNDICE DO DESPERTADOR, e ele bate A CADA 5 MINUTOS.
  /// `lib/agency/despertador.ts:62` procura projeto para retomar com um `OR` de
  /// três condições sobre `executionStatus`, ordenando por
  /// `executionRequestedAt`. Sem índice, cada batida é uma varredura completa
  /// da tabela — e numa SQLite em volume a varredura SEGURA O LOCK DE ESCRITA.
  /// É assim que "database is locked" vira erro de deploy; o retry do
  /// `scripts/start.sh` existe por causa desse sintoma.
  @@index([executionStatus, executionRequestedAt])
  @@index([workspaceId])
  @@index([clientId])
  @@index([clientRequestId])
}

// ─── Ciclos ───────────────────────────────────────────────────────────────────

/// O CICLO MENSAL — onde a relação vitalícia acontece.
///
/// Um projeto que nunca fecha não é medível: nada é entregue de fato, nada é
/// comparado, o painel nunca fica verde. Por isso a operação contínua não é um
/// projeto infinito — é uma sequência de ciclos que nascem, entregam, medem e
/// fecham. É o que permite dizer "agosto foi melhor que julho", e é isso que
/// segura um cliente por anos.
/// Uma campanha de tráfego pago que ESTA agência criou na conta do cliente.
///
/// Existe porque dinheiro precisa de rastro. Sem esta tabela, "quem mandou
/// gastar R$ 40 por dia na conta da padaria?" não teria resposta — só um id
/// solto dentro da Meta. Aqui ficam o teto que o cliente aprovou, quem
/// autorizou ligar e quando.
model AdCampaign {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String?
  projectId      String?
  /// Conexão Meta usada. É por ela que se descobre em qual conta isto vive.
  connectionId   String
  /// "act_..." — a conta de anúncio do cliente.
  adAccountId    String
  /// O id da campanha dentro da Meta.
  externalId     String
  /// O conjunto e o anúncio. Uma campanha SEM estes dois não entrega nada — é
  /// um envelope com verba. Ficam aqui porque ativar a campanha sem subir os
  /// filhos junto deixa a conta com cara de ligada e gastando zero.
  adSetId        String?
  adId           String?
  /// Resumo legível do público, para o painel e o relatório. Nunca é a fonte
  /// da verdade da segmentação — essa vive dentro da Meta.
  audience       String?
  name           String
  objective      String
  dailyBudgetBRL Float
  /// O teto que o cliente aprovou POR ESCRITO, congelado no momento da criação.
  /// Congelado de propósito: se o teto mudar depois, o que foi criado ontem
  /// continua julgável pelo que valia ontem.
  approvedCapBRL Float
  /// paused | active | ended
  status         String    @default("paused")
  /// Quem mandou ligar. Nulo enquanto nunca foi ativada.
  activatedBy    String?
  activatedAt    DateTime?
  /// Quando o guardião de verba freou sozinho, e por quê. Campanha que gasta
  /// sem entregar é o erro que ninguém percebe até a fatura chegar.
  pausedByGuardAt DateTime?
  pausedReason   String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([projectId])
  /// O guardião de verba (`lib/agency/esteira/trafego.ts:332`) busca
  /// `{ status: "active" }` SEM workspace, a cada batida do despertador. O
  /// índice `[workspaceId, status]` não serve: a coluna líder é a errada, e
  /// índice só é usado a partir do prefixo da esquerda.
  @@index([status])
}

/// A conta do Google Meu Negócio de um cliente.
///
/// Existe separada da `MetaConnection` de propósito: o ciclo de vida é outro.
/// O token do Google EXPIRA em 1h e se renova por refresh token; o da Meta dura
/// 60 dias e não se renova sozinho. Enfiar os dois na mesma tabela obrigaria
/// todo leitor a saber de qual provedor aquela linha é antes de usá-la — e é
/// exatamente aí que se publica na conta errada.
model GoogleConnection {
  id                    String    @id @default(cuid())
  workspaceId           String
  /// Nulo = a conta da própria Dioli. Preenchido = a conta de um cliente.
  clientId              String?
  /// "locations/123456" — o id do local dentro do Google.
  locationName          String
  /// "accounts/987654" — a conta que administra o local.
  accountName           String
  /// Nome legível: "Padaria do João — Centro".
  title                 String    @default("")
  accessTokenEncrypted  String
  /// O refresh token é o que sustenta a conexão viva. Sem ele, a conta cai em
  /// uma hora e alguém precisa reconectar à mão — o oposto de automático.
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                String    @default("connected") // connected | expired | revoked | error
  /// Até quando já lemos avaliações. Sem isto, cada rodada reprocessaria o
  /// histórico inteiro e responderia avaliação de dois anos atrás.
  reviewsSyncedAt       DateTime?
  /// A política da API do Business Profile PROÍBE resposta automatizada a
  /// avaliação "sem o consentimento prévio e específico do usuário"
  /// (docs/plataformas/google/fontes/business-profile-api-politicas.md).
  /// Nulo = sem consentimento registrado → NENHUMA resposta sai sozinha,
  /// tudo vira rascunho escalado. Preenchido = quando o cliente autorizou.
  autoReplyConsentAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([workspaceId, locationName])
  @@index([clientId])
}

/// Uma avaliação do Google e o que a agência fez com ela.
///
/// Fica no banco porque responder avaliação é PÚBLICO e PERMANENTE: precisa de
/// rastro de quem respondeu o quê e quando, e de uma trava para não responder
/// duas vezes a mesma avaliação.
model GoogleReview {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String?
  connectionId   String
  /// O id da avaliação no Google. É a chave de idempotência.
  externalId     String
  reviewerName   String    @default("")
  starRating     Int       @default(0)
  comment        String    @default("")
  createdAtGoogle DateTime?
  /// pendente | respondida | escalada | ignorada
  status         String    @default("pendente")
  /// A resposta que a agência escreveu. Guardada mesmo quando escalada — é o
  /// rascunho que a gente mostra a quem vai decidir.
  reply          String?
  repliedAt      DateTime?
  /// Por que virou assunto de gente. Avaliação negativa nunca é respondida
  /// sozinha: resposta errada a cliente irritado é pública e permanente.
  escalatedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([connectionId, externalId])
  @@index([workspaceId, status])
}

// ─── Google Drive do CLIENTE — o material de marca vem de lá ─────────────────

/// A conexão do Google Drive DO CLIENTE com o portal dele.
///
/// Separada de `GoogleConnection` de propósito: aquela é o Meu Negócio (perfil,
/// avaliações, posts — ESCRITA pública em nome do cliente) e usa o escopo
/// `business.manage`. Esta é SÓ LEITURA de material, com o escopo estreito
/// `drive.file`, e o cliente escolhe arquivo por arquivo no seletor do Google.
/// Misturar as duas numa linha só faria um consentimento carregar o outro — e
/// "alcance nunca é autorização" é a regra da casa desde 06/08/2026.
///
/// O escopo `drive.file` é NÃO SENSÍVEL: dá acesso por arquivo, só ao que o
/// usuário abriu com o app pelo Google Picker
/// (fonte: docs/plataformas/google/fontes/drive-api-escopos.md). Escopo amplo
/// (`drive`, `drive.readonly`) é RESTRITO: exige verificação restrita e
/// avaliação de segurança — meses. Não usamos, e não é para usar.
model GoogleDriveConnection {
  id                    String    @id @default(cuid())
  workspaceId           String
  /// O dono. SEMPRE derivado do token do portal, nunca do que o navegador manda.
  clientId              String
  /// A conta Google que autorizou, só para o cliente reconhecer qual é ("j***@gmail.com").
  /// Guardado mascarado: e-mail inteiro é PII e não precisa ficar aqui.
  contaHint             String    @default("")
  accessTokenEncrypted  String
  /// Sem refresh token a conexão morre em 1h. E com o app OAuth em "Teste", o
  /// PRÓPRIO refresh token expira em 7 dias
  /// (fonte: fontes/oauth2-tokens-e-expiracao.md) — por isso `status` tem
  /// "expired" e a tela do cliente diz a verdade em vez de erro genérico.
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  /// Os escopos que o Google efetivamente concedeu. Conferidos na volta: se
  /// `drive.file` não vier, a conexão NÃO é gravada como utilizável.
  escopos               String    @default("")
  /// connected | expired | revoked | error
  status                String    @default("connected")
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([workspaceId, clientId])
  @@index([clientId, status])
}

/// UM arquivo que o cliente escolheu no seletor do Google — e o papel que ELE
/// disse que aquele arquivo tem.
///
/// A trava mora aqui: `papel` só vale quando `papelConfirmadoEm` está
/// preenchido, e só o CLIENTE preenche. Arquivo escolhido sem papel confirmado
/// existe no banco, aparece na tela como "falta dizer o que é" e **não é
/// insumo de nada**. O motivo é o defeito que o CEO nomeou: adivinhar que
/// "IMG_2831.jpg" é a foto do produto produz peça com a foto errada, que é pior
/// que peça sem foto.
///
/// E material daqui é INSUMO, não verdade: ter a foto do produto no Drive não
/// autoriza a casa a afirmar nada sobre o negócio. O piso de verdade
/// (lib/agency/execution/piso-de-verdade.ts) continua valendo inteiro.
/// O MATERIAL DE MARCA DO CLIENTE — a ÚNICA porta de arquivo para dentro de uma
/// peça (lib/agency/esteira/material-do-drive.ts::materiaisDeMarca).
///
/// ⚠️ O NOME DO MODELO É DÍVIDA DECLARADA. Ele nasceu só para o Google Drive e
/// hoje guarda também o que o cliente arrasta no portal (`origem`). Renomear é
/// migration de tabela inteira num SQLite em volume; ficou de fora de propósito.
/// Quem ler `DriveMaterial` deve ler "material de marca", não "material do Drive".
model DriveMaterial {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String
  /// DE ONDE VEIO O ARQUIVO. Lista fechada em escolha-de-material.ts:
  ///   • "drive"        — escolhido no Picker do Google. EXIGE conexão viva.
  ///   • "envio_direto" — arrastado no portal ou subido pelo admin. A casa já
  ///     tem os bytes pelo ato do próprio dono; NÃO depende do Google para nada.
  ///
  /// É coluna, e não um prefixo dentro de `connectionId`, de propósito: esconder
  /// o modelo dentro de uma string é o atalho que a casa paga em três meses.
  origem         String    @default("drive")
  /// A conexão do Google que autorizou. NULA quando `origem = "envio_direto"` —
  /// é exatamente o ponto da mudança: envio direto sobrevive ao Google caído.
  connectionId   String?
  /// O id do arquivo dentro do Drive. Chave de idempotência da escolha.
  /// Em `envio_direto` guarda o id do `MediaAsset`, que é a mesma coisa: o
  /// identificador estável do arquivo na origem de onde ele veio.
  fileId         String
  /// Nome como está no Drive do cliente. Pode ser "IMG_2831.jpg" — e é por isso
  /// que ele não decide nada sozinho.
  nome           String    @default("")
  mimeType       String    @default("")
  tamanhoBytes   Int       @default(0)
  /// "pasta" quando o cliente escolheu uma PASTA em vez de um arquivo.
  ehPasta        Boolean   @default(false)
  /// O papel declarado pelo CLIENTE. Lista fechada em
  /// lib/integrations/google/escolha-de-material.ts. Null = não declarado.
  papel          String?
  /// O palpite da casa, mostrado ao cliente como sugestão a CONFIRMAR. Nunca
  /// vale como declaração — fica gravado só para a tela já vir preenchida.
  papelSugerido  String?
  /// Quando o CLIENTE confirmou o papel. Null = material inutilizável.
  papelConfirmadoEm DateTime?
  /// A cópia local, depois de importada. Null = ainda não baixamos.
  mediaAssetId   String?
  importadoEm    DateTime?
  /// Por que a importação falhou, em português, quando falhou.
  erro           String?
  escolhidoEm    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([connectionId, fileId])
  /// A idempotência do ENVIO DIRETO. `connectionId` é NULO nessa origem, e NULL
  /// não colide com NULL em índice único — então a chave acima não protege esse
  /// caminho. Esta protege: um arquivo guardado = no máximo uma linha de
  /// material. Sem ela, reenviar o mesmo logo duplicaria o material da peça.
  @@unique([clientId, mediaAssetId])
  @@index([clientId, papel])
  @@index([clientId, origem])
  @@index([workspaceId, papelConfirmadoEm])
}

model Cycle {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Competência do ciclo, sempre AAAA-MM. Um por mês, por projeto.
  reference   String
  /// aberto | entregue | fechado
  status      String    @default("aberto")
  startsOn    String
  endsOn      String
  /// O que este ciclo se comprometeu a entregar (JSON), congelado na abertura.
  planJson    String    @default("[]")
  /// Números do fechamento (JSON): o que foi medido no fim.
  resultsJson String    @default("{}")
  /// A leitura do ciclo em uma frase — o que melhorou, o que não.
  summary     String?
  /// Quando o pacote DESTE ciclo foi mostrado ao cliente. Por ciclo, não por
  /// projeto: o carimbo do projeto só serve ao pacote inicial, e sem este a
  /// entrega do mês 2 nunca chegaria a ser apresentada.
  presentedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, reference])
  @@index([projectId, status])
}

// ─── Avisos ao cliente ────────────────────────────────────────────────────────

/// O AVISO — a ponte entre "a esteira precisa de algo" e "o cliente ficou sabendo".
///
/// A esteira escreve no portal, mas o portal só existe se o cliente abrir. Sem
/// esta tabela, um pedido de material podia ficar semanas parado porque ninguém
/// avisou que ele existia — o projeto travado e a agência achando que a bola
/// estava com o cliente.
///
/// A regra: o aviso NUNCA se perde. Se houver canal automático configurado, ele
/// sai sozinho e o registro fica como comprovante. Se não houver, o aviso vira
/// FILA para o time disparar à mão — com o texto e o link já prontos, para não
/// depender de alguém escrever bem às pressas.
///
/// Isso resolve a restrição real do WhatsApp: fora da janela de 24h a Meta só
/// aceita template aprovado, e aprovação leva dias. Até lá o aviso sai pela mão
/// de gente, mas sai — e o sistema sabe se saiu.
model ClientNotice {
  id          String  @id @default(cuid())
  workspaceId String
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?

  /// direcao | material | entrega | ciclo
  kind String
  /// O que o cliente precisa saber, já redigido para ser lido por ele.
  body String
  /// O link do portal que resolve este aviso.
  link String?

  /// pendente | enviado | falhou | dispensado
  status     String    @default("pendente")
  /// whatsapp | email | manual | nenhum
  channel    String    @default("nenhum")
  /// Por que não saiu sozinho — para a equipe entender sem adivinhar.
  failReason String?
  sentAt     DateTime?
  /// Quem disparou, quando foi à mão.
  sentBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([clientId, status])
  /// Quantas vezes a fila JÁ reenviou este aviso sozinha. Sem contador, o
  /// reenvio automático vira a rajada que esta casa já pagou caro: insistir
  /// para sempre contra um canal que não volta.
  retryCount     Int      @default(0)
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  type            String
  status          String   @default("draft")
  revisionStatus  String?
  /// QUEM julgou esta peça — o provedor de IA que deu o veredito. NULO = nenhum
  /// modelo julgou (retida, ou reprovada pela régua determinística de código).
  ///
  /// `revisionStatus` responde "qual foi o veredito"; este campo responde "quem
  /// julgou". Eram a mesma coluna até 25/08/2026, e por isso uma peça julgada
  /// pelo próprio autor era indistinguível de uma julgada por árbitro
  /// independente em TODA tela da casa. Ver `quality-auditor.ts`.
  qualityArbiter  String?
  /// A arbitragem em UMA palavra: `arbitro_independente` | `autojulgado` |
  /// `sem_arbitro`. Escrita só por `arbitragemDoVeredito` — ponto único de
  /// tradução, para nenhuma tela comparar provedor com autor na mão.
  ///
  /// NULO = peça anterior a 25/08/2026, quando a casa não media isto. Nulo é
  /// "não medido", NUNCA "independente": ausência de medição não é verde.
  qualityArbitragem String?
  /// Contrato de visibilidade do Hub (interno | aguardando_publicacao |
  /// compartilhado). Nasce "interno" de propósito: a auditoria do Hub provou
  /// que o padrão fail-open ("o que a rota esquecer de filtrar, vaza") é o
  /// maior risco do portal. Vira "compartilhado" no ato de apresentar ao
  /// cliente (esteira/marcos.ts, esteira/mes.ts) — nunca por omissão.
  visibility      String   @default("interno")
  content         String?
  clientFeedback  String?
  lastFeedback    String?
  ownerAgentId    String?
  /// De que ciclo mensal esta entrega é. NULO = entrega do pacote inicial (o
  /// projeto, antes de virar rotina). É a chave que faz o mês 2 existir: sem
  /// ela a idempotência por especialista vale para sempre e a agência entrega
  /// uma vez só na vida do cliente.
  cycleId         String?
  /// De que LEVA do ciclo esta entrega é (1, 2, 3…). NULO = entrega anterior a
  /// 25/08/2026, quando o mês inteiro saía numa passada só — leia nulo como
  /// leva 1, nunca como "sem leva".
  ///
  /// É a chave que faz a SEGUNDA passada do mês existir: a idempotência do
  /// motor é por especialista dentro do ciclo, e sem esta coluna o especialista
  /// de conteúdo que já produziu no dia 1 nunca mais produziria naquele ciclo —
  /// que é exatamente por que o teto real da casa era 12 peças/mês.
  leva            Int?
  version         Int      @default(1)
  // JSON-encoded revision history
  revisionHistory String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions DeliverableVersion[]

  @@index([projectId, cycleId])
}

/// Versão de entregável como registro de primeira classe (Hub, Fase 1, 1.9).
///
/// Existe porque a exigência "gera nova versão sem apagar a anterior" era
/// incumprível: a refação sobrescrevia `Deliverable.content` e o histórico JSON
/// guardava notas, não o corpo — o cliente pedia ajuste e a v1 sumia do mundo.
/// A regra: cada versão é IMUTÁVEL depois de criada; `Deliverable.content` passa
/// a ser cache da versão corrente (leitura sempre pode reconstruir pela versão).
/// O retrofit é preguiçoso de propósito: a versão N nasce com o conteúdo atual
/// no primeiro momento em que alguém vai sobrescrevê-lo (esteira/versoes.ts).
model DeliverableVersion {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  number        Int
  content       String?
  mediaAssetIds String      @default("[]")
  /// Executor que produziu ESTA versão (agente ou "client:..." nunca — cliente
  /// não escreve versão; ele decide sobre ela).
  createdBy     String?
  /// O que mudou e em resposta a qual comentário — a memória da refação.
  note          String?
  createdAt     DateTime    @default(now())

  approvals ApprovalRequest[]

  // Uma versão por número, por entregável — é o que torna o retrofit idempotente.
  @@unique([deliverableId, number])
}

// ─── Material Requests ────────────────────────────────────────────────────────

/// O pedido de material que um agente faz ao cliente.
///
/// Regra da casa: o agente ABRE o pedido, o gerente de projeto CONSOLIDA e fala.
/// O cliente recebe uma mensagem só, com tudo que falta — nunca cinco agentes
/// pedindo coisas soltas em horários diferentes. Por isso o pedido guarda quem
/// pediu (para a equipe saber quem está travado) e quando foi enviado ao cliente
/// (para o PM não cobrar a mesma coisa duas vezes).
model MaterialRequest {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               String
  description        String
  status             String    @default("pending")
  /// Qual agente travou por falta deste material (a3, a2…).
  requestedByAgentId String?
  /// Nome legível de quem pediu — vai no resumo que o PM manda.
  requestedByLabel   String?
  /// Quando o PM incluiu este pedido na mensagem consolidada ao cliente.
  askedClientAt      DateTime?
  requestedAt        DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([projectId, status])
}

// ─── Pedido de conteúdo — a PRIMEIRA seta que aponta cliente → agência ────────

/// O pedido que o CLIENTE faz à agência: "quero uma peça nova".
///
/// Por que NÃO é um MaterialRequest com a seta invertida (a pergunta que o CEO
/// mandou justificar): o MaterialRequest é o portão de recursos — ele existe
/// para TRAVAR produção por falta de insumo. `assess-resources` abre um por item
/// faltante, `esteira/pedidos.ts` consolida e o portal os lista sob "A produção
/// está esperando:". Um pedido do cliente entrando ali apareceria para o próprio
/// cliente como coisa que ELE deve entregar, e travaria o projeto dele. A seta é
/// oposta e o efeito é oposto — mesma forma, semântica invertida.
///
/// Também não cabe em ClientRequestDb: aquilo é a porta do PROSPECT (briefing,
/// SDR, proposta). Um cliente que já paga pedindo mais um reels não é um lead
/// novo; entraria na fila de "Solicitações" com status "new" e sujaria o funil.
///
/// O que este modelo carrega é o MÍNIMO que um especialista precisa para
/// produzir sem inventar: o que, para quando e para qual objetivo. Nada de
/// formulário longo — o cliente não preenche.
model ContentRequest {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String    @id @default(cuid())
  /// O dono. Vem SEMPRE do token (derivação, nunca comparação — regra da casa
  /// de 03/08/2026). Cascata porque um pedido sem cliente não significa nada.
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// A solicitação do briefing, quando o cliente veio por lá. Ponteiro sem FK:
  /// o `/api/admin/reset` mexe nessa tabela por conta própria.
  clientRequestId String?
  /// O projeto que recebeu o pedido. Nulo até a triagem — e nulo é honesto:
  /// cliente sem projeto aberto NÃO ganha tarefa inventada.
  projectId       String?
  /// Título curto derivado da descrição, só para a lista da caixa de entrada.
  title           String
  /// O QUE ele quer, nas palavras dele. NUNCA vazio — pedido mudo não vira
  /// tarefa muda: a rota devolve a pergunta em vez de gravar.
  description     String
  /// PARA QUAL OBJETIVO. Também obrigatório: sem o porquê, o especialista
  /// escolhe o ângulo sozinho — que é exatamente inventar verdade.
  objective       String
  /// PARA QUANDO, quando o cliente sabe dizer. Opcional de propósito: a maioria
  /// não sabe, e obrigar a chutar data produz prazo falso no sistema.
  desiredFor      DateTime?
  /// URLs de material já enviado pelo portal (/api/media). JSON de strings.
  attachmentsJson String    @default("[]")
  /// A MÁQUINA DE ESTADOS DO PEDIDO. Todo valor aqui é LIDO por alguma tela:
  /// `STATUS_PARA_O_CLIENTE` (app/api/portal/pedidos/route.ts) no portal e
  /// `CaixaDeEntrada.tsx` na agência. Estado que ninguém lê é vazamento.
  ///
  ///   novo            → acabou de entrar; a triagem automática ainda não pegou
  ///   em_triagem      → a triagem está decidindo AGORA (trava atômica; parada
  ///                     há +10 min o despertador retoma)
  ///   triado          → departamento, prazo e (quando extra) preço definidos
  ///   em_producao     → o especialista está produzindo (mesma trava por tempo)
  ///   entregue        → virou Deliverable + card de aprovação no portal
  ///   precisa_decisao → FAIL-CLOSED: a máquina não soube resolver. `declineReason`
  ///                     diz por quê, em português, e aparece para os dois lados
  ///   recusado        → a agência não vai seguir, com motivo
  status          String    @default("novo")
  /// A decisão de ESCOPO, tomada por gente: "ciclo" (entra no ciclo corrente)
  /// ou "extra" (escopo adicional a combinar). Nasce NULA de propósito — preço
  /// e prazo não se inventam, e o plano do ciclo é congelado na abertura.
  scopeDecision   String?
  /// O ORÇAMENTO, em reais inteiros. Preenchido na triagem quando a decisão é
  /// "extra" — e obrigatório nesse caminho: escopo adicional sem preço é a
  /// discussão que aparece depois, com a peça já feita. Nulo em "ciclo", que
  /// por definição já está pago pela mensalidade.
  quotedPrice     Int?
  /// O que o preço cobre, em uma frase que o cliente lê. Preço sem escopo é
  /// número solto — e número solto sempre parece caro.
  quoteNote       String?
  /// pendente | aceito | recusado. Nulo = não há orçamento na mesa.
  quoteStatus     String?
  quoteDecidedAt  DateTime?
  /// O PRODUTO CANÔNICO que a triagem decidiu entregar (`produtos/registro.ts`).
  ///
  /// Nasceu na Operação Salvaguarda (25/08/2026) para consertar um defeito de
  /// classe: **o formato pedido pelo cliente não sobrevivia à triagem.** Story,
  /// post e carrossel caíam no mesmo atendimento, com o mesmo item de catálogo
  /// (`balcao-post-feed`) e o mesmo especialista — e não existia campo nenhum
  /// onde "isto é um story" pudesse ser gravado. O critério de aceite "o formato
  /// permanece `story` em todas as transições" era uma pergunta sem sujeito.
  ///
  /// Nulo = pedido sem produto canônico declarado, que é o estado de todos os
  /// pedidos anteriores a esta data e de todos os atendimentos ainda não
  /// migrados. Nulo NÃO é "story" e NÃO é um produto padrão: quem lê trata a
  /// ausência como ausência e segue pelo caminho de sempre.
  produtoId       String?
  /// A tarefa criada na triagem. É por aqui que o pedido encontra a esteira.
  taskId          String?
  /// Quem triou e quando — pedido parado sem dono é vazamento.
  /// `triagedAt` é TAMBÉM o relógio da trava: `em_triagem`/`em_producao` parado
  /// há mais de 10 min significa que o processo morreu no meio, e o despertador
  /// retoma. Sem isso a trava vira armadilha.
  triagedBy       String?
  triagedAt       DateTime?
  /// O PRAZO QUE A AGÊNCIA PROMETEU. Diferente de `desiredFor`, que é a data que
  /// o CLIENTE pediu: um é desejo, outro é compromisso, e confundir os dois é
  /// como a agência passa a dever o que nunca combinou. Sai da tabela
  /// (`deliveryDays` do catálogo), nunca do modelo.
  promisedFor     DateTime?
  /// A peça que este pedido virou. É o elo que faltava: sem ele, "entregue" é
  /// uma palavra sem lastro e ninguém consegue ir do pedido até o que saiu.
  deliverableId   String?
  /// Quantas vezes a produção automática TENTOU e não concluiu por motivo
  /// transitório (IA fora do ar, rede). Mesmo papel do `Project.executionAttempts`:
  /// separar "o mundo estava ruim naquele minuto" de "isto precisa de gente".
  /// Sem o contador, ou o despertador retenta para sempre queimando IA, ou uma
  /// piscada de rede vira trabalho humano. Lido pelo despertador.
  productionAttempts Int    @default(0)
  /// Por que foi recusado — ou por que PAROU. Em linguagem que o cliente lê:
  /// é o mesmo campo que carrega o motivo do `precisa_decisao`.
  declineReason   String?
  /// QUANDO A ESCADA DE EXPOSIÇÃO RETEVE ESTE PEDIDO. Nulo = não foi ela.
  ///
  /// Nasceu em 25/08/2026 e tem UM leitor nomeado, que é a razão de existir:
  /// `repescarPedidosRetidosPelaEscada` (`escada/repescagem.ts`). Sem esta
  /// coluna, um pedido parado em `precisa_decisao` pela escada é
  /// indistinguível de um parado pela Qualidade ou pelo piso de verdade — e
  /// retentar os outros dois seria abrir a porta dos fundos dos dois portões.
  ///
  /// NÃO é derivável de `declineReason`: aquele campo é texto para o cliente
  /// ler, e casar defeito por substring é a régua que quebra na primeira vez
  /// que alguém melhora a frase.
  escadaRetidaEm  DateTime?
  /// Quantas vezes a repescagem já rearmou este pedido depois de a escada o
  /// reter. É o FREIO: em `MAX_REPESCAGENS_DO_PEDIDO` a repescagem para de
  /// tentar e declara a parada (motivo, dono e próxima ação). Sem teto, um
  /// degrau que abre e fecha faria a casa reproduzir a mesma peça para sempre,
  /// com IA paga em cada volta.
  escadaRepescagens Int    @default(0)
  /// ── A PORTA DA PERGUNTA (25/08/2026) ────────────────────────────────────
  ///
  /// A pergunta ESTRUTURADA que a casa fez ao cliente, com as respostas
  /// possíveis e o efeito de cada uma (`lib/agency/esteira/porta-da-pergunta.ts`).
  ///
  /// `declineReason` diz ao cliente POR QUE parou, em prosa. Isto diz COMO ele
  /// responde. Eram a mesma coisa e não são: a Ana leu o motivo, respondeu no
  /// chat "pode ser o pacote de 4" e o pedido não andou, porque prosa não tem
  /// botão e o chat livre não tem quem decida escopo. Proibição sem instrução
  /// gêmea é beco.
  ///
  /// Nulo = não há pergunta aberta. É o estado normal, e é o que o cartão do
  /// portal lê para NÃO mostrar botão nenhum. Respondida, volta a nulo na mesma
  /// escrita — pergunta que sobrevive à resposta é a mesma pergunta duas vezes.
  pendingQuestionJson String?
  /// A quantidade que o CLIENTE confirmou respondendo à pergunta acima.
  ///
  /// Existe porque a leitura da quantidade é léxica e roda no texto ORIGINAL
  /// (`leitura-do-pedido.ts`) — que continua dizendo "1 story" depois de o
  /// cliente ter dito "pode ser o pacote de 4". Sem esta coluna, rodar a
  /// triagem de novo daria exatamente a mesma parada, para sempre.
  ///
  /// Nulo = o cliente não confirmou número nenhum, e aí vale a leitura do
  /// texto. Nulo NUNCA vira 1: quantidade inventada é erro de dinheiro.
  confirmedQuantity Int?
  /// O ENTREGÁVEL que o CLIENTE confirmou respondendo à porta da pergunta:
  /// "peca" (a arte pronta) ou "insumo" (o texto/roteiro para ele produzir).
  ///
  /// Irmã de `confirmedQuantity`, e pelo mesmo motivo: a leitura do entregável
  /// é léxica e roda no texto ORIGINAL (`leitura-do-pedido.ts`). Quando ela lê
  /// "ambíguo" ou lê INSUMO onde a classificação escolheu PEÇA, a triagem para
  /// e pergunta — e sem esta coluna, rodar a triagem de novo depois da resposta
  /// daria exatamente a mesma parada, para sempre.
  ///
  /// Nulo = o cliente não confirmou nada, e vale a leitura do texto. Nulo NUNCA
  /// vira "peca": escolher o entregável por ele é cobrar o trabalho errado.
  confirmedDeliverable String?
  /// A CHAMADA PARA AÇÃO que o CLIENTE confirmou respondendo à porta da
  /// pergunta — "chamar no WhatsApp", "vir na loja", "pedir pelo link da bio".
  ///
  /// O portão do briefing mínimo (`produtos/briefing-minimo.ts`) PARA a
  /// produção quando o texto do cliente não traz chamada para ação, e está
  /// certo: sem ela quem inventa a ação (e o canal junto) é o modelo. O que
  /// faltava era o caminho DEPOIS da parada — medido em produção com cliente
  /// oculto em 26/08/2026: o pedido parou com o motivo escrito e `pergunta:
  /// null`, e um cliente que só sabe usar o portal não tinha onde responder.
  ///
  /// Nulo = o cliente não confirmou ação nenhuma, e vale a leitura léxica do
  /// texto dele. Nulo NUNCA vira uma CTA padrão: ação inventada manda o cliente
  /// do cliente para um lugar que talvez não exista.
  confirmedCta String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, status])
  @@index([status, createdAt])
  /// A consulta da repescagem: os retidos pela escada, e só eles.
  @@index([escadaRetidaEm])
}

// ─── Brand Brain ─────────────────────────────────────────────────────────────

model BrandBrain {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brandName      String?
  tagline        String?
  primaryColor   String?
  secondaryColor String?
  typography     String?
  tone           String?
  values         String   @default("[]")
  targetAudience String?
  positioning    String?

  // ── OS CAMPOS QUE PERMITEM JULGAR (09/08/2026) ───────────────────────────
  //
  // Os campos acima dizem quem a marca É. Sozinhos, eles nunca permitiram
  // reprovar nada — e foi por isso que, medido neste dia, quem produzia recebia
  // apenas público-alvo e tom. O esquema abaixo vem da constituição do
  // `branding` (dioli-brain-kit, doutrina 23), que o Conselho desenhou em
  // 09/08: nove campos, e cada um só entra porque MUDA UMA DECISÃO.
  //
  // As PROIBIÇÕES não estão aqui de propósito: já existem, funcionam e moram em
  // `BrainArtifact` (departamento `proibicoes-do-cliente`). Duplicá-las numa
  // coluna criaria duas verdades sobre a mesma regra — o defeito que esta casa
  // já pagou caro em preço e em material.

  /// O que a marca serve e o que quem interage pode esperar. Barra trabalho que
  /// promete efeito fora do que ela entrega.
  purposeAndPromise String?
  /// A quem fala e em que posição (par, autoridade, prestador). Decide
  /// tratamento e distância.
  audienceRelation  String?
  /// JSON: pares "dizemos assim / não dizemos assim", com exemplos LITERAIS.
  /// Adjetivo não é verificável; par de exemplo é.
  voicePairsJson    String  @default("[]")
  /// JSON: grafia canônica do nome, termos obrigatórios e proibidos. É o único
  /// campo checável de forma determinística.
  lexiconJson       String  @default("{}")
  /// JSON: artefatos aprovados E reprovados, com motivo. O contra-exemplo
  /// ensina mais que o exemplo — e faltavam os dois.
  referencesJson    String  @default("{}")
  /// JSON: tokens invariáveis expressos como VALORES, nunca como adjetivos.
  formalTokensJson  String  @default("{}")
  /// JSON: os RÓTULOS DE BENEFÍCIO que esta marca autoriza na ARTE — os chips
  /// ("Vagas conferidas", "Perto de casa", "Alto Tietê").
  ///
  /// Existe desde 15/08/2026, quando o molde ganhou o slot de chip e a trava
  /// ganhou a forma de rótulo de benefício. Por que é uma coluna e não texto
  /// derivado: chip é o que a marca AFIRMA de si dentro do pixel, e pixel
  /// publicado não se corrige — se corrige apagando o post. Quem declara isso é
  /// o dono da marca, uma vez, e não o modelo a cada peça.
  ///
  /// Vazio é o estado normal e honesto: peça sem chip é a peça de antes de
  /// 15/08. Nenhum cliente ganha chip por padrão — e a faixa de chamada só é
  /// emitida para quem declarou rótulos aqui, porque é este campo que registra
  /// que a marca quer este estilo de peça.
  ///
  /// Cada rótulo ainda passa por `travaDeRotuloDeBeneficio` antes de virar
  /// pixel: preencher aqui é declarar, não é liberar.
  artLabelsJson  String  @default("[]")
  /// O que a marca não pode afirmar sobre si AINDA QUE SEJA VERDADE
  /// (superlativo, garantia, comparação com terceiro). É a fronteira exata com
  /// o `qualidade`: ele julga se é verdade, isto julga se pode ser dito.
  promiseLimits     String?
  /// JSON: qual regra vence quando duas colidem, mais o humano dono, o canal e
  /// o prazo de resposta. Sem isto a escalada não tem endereço.
  ownerAndHierarchyJson String @default("{}")
  /// JSON por campo: "definido" | "lacuna" | "herdado_default", com data e
  /// autor. É o ESTADO, e não um décimo campo, que impede ausência de virar
  /// informação — a regra que o Conselho fez questão de separar.
  fieldStatesJson   String  @default("{}")

  updatedAt      DateTime @updatedAt
}

// ─── Strategy Room ────────────────────────────────────────────────────────────

model StrategyRoom {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String?
  status       String   @default("generating")
  // Full StrategyRoom object (specialists, debate turns, consensus, executive
  // summary, synthesis) serialized as JSON — pragmatic single-column storage.
  analysisJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Briefings ─────────────────────────────────────────────────────────────

model Briefing {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
  estadoCanonico String?
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId        String
  goal            String
  audience        String   @default("")
  keyMessage      String   @default("")
  deliverables    String   @default("")
  deadline        String   @default("")
  successCriteria String   @default("")
  notes           String?
  status          String   @default("pending_analysis")
  createdAt       DateTime @default(now())
}

// ─── Brand Updates ─────────────────────────────────────────────────────────
// Pending brand suggestions (client portal / manual / upload / parsed) queued
// before being applied to the client's BrandBrain.

model BrandUpdate {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field          String
  suggestedValue String
  currentValue   String?
  source         String   @default("manual")
  status         String   @default("pending")
  note           String?
  fileName       String?
  submittedAt    DateTime @default(now())
}

// ─── Brain Updates (learning loop) ────────────────────────────────────────────
// Department-scoped feedback proposals from approved deliverables / quality
// reviews / human edits. NEVER auto-applied — a human applies each one, which
// then mutates the actual BrandBrain. Distinct from BrandUpdate (portal/manual
// brand-field queue) — this captures the Brain's own learning signal.

model BrainUpdate {
  id              String    @id @default(cuid())
  clientRequestId String
  department      String
  fieldChanged    String // which brand brain field
  previousValue   String?
  proposedValue   String
  source          String // "approved_delivery" | "quality_review" | "human_edit"
  status          String    @default("pending") // "pending" | "applied" | "rejected"
  createdAt       DateTime  @default(now())
  appliedAt       DateTime?
}

// ─── Integration Configs ──────────────────────────────────────────────────────

model DbIntegrationConfig {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationId    String
  configured       Boolean         @default(false)
  selectedModel    String?
  configWorkspace  String?
  accountId        String?
  folder           String?
  webhookUrl       String?
  // API key storage — AES-256-GCM encrypted (see lib/security/crypto.ts).
  // apiKeyHint is a non-sensitive display string e.g. "sk-ant-…a1b2".
  apiKeyEncrypted  String?
  apiKeyHint       String?
  lastTestStatus   String          @default("not_run")
  lastTestAt       DateTime?
  lastTestMessage  String?
  lastConfiguredAt DateTime?

  @@unique([workspaceId, integrationId])
}

// ─── A ESCOLHA DE PROVEDOR DE IA, POR CLIENTE ────────────────────────────────
//
// Substitui `DbAgentProviderConfig`, que era gravado pela tela e lido por
// NINGUÉM — a decisão real estava fixa em `especialistas.ts`. Uma tela que
// grava e não manda mente para o operador; esta tabela só existe porque tem um
// leitor nomeado: `lib/ai/escolha-por-cliente.ts`, chamado dentro de
// `lib/ai/generate.ts`, que é o portão único por onde toda IA desta casa passa.
//
// POR QUE POR CLIENTE E NÃO POR ENV: `BRAIN_AI_PROVIDER` é global. Ligar a faixa
// gratuita por env poria a Foocci (cliente pagante) na cobaia junto com a
// agência. A ordem do CEO é "testar na agência primeiro" — e isso exige que a
// escolha tenha dono.
model ClientAiProvider {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// O cliente cobaia. Uma linha por cliente; sem linha = preferência da casa.
  clientId    String
  /// "claude" | "openai" | "gemini" | "deepseek" | "perplexity".
  /// Texto e não enum: valor desconhecido tem que cair na preferência da casa,
  /// não explodir o motor no meio de uma produção.
  provider    String
  /// Modelo específico. Nulo = o default do provedor (`modeloPadrao`).
  model       String?
  /// SEM RESERVA. `true` (o default) = se o provedor escolhido falhar, a casa
  /// DIZ que não conseguiu em vez de deixar outro atender por baixo.
  ///
  /// O default é `true` de propósito: a razão de fixar um provedor num cliente é
  /// MEDIR aquele provedor. Reserva calada mede o reserva e entrega ao cliente
  /// uma peça de padrão diferente do que o painel afirma — degradação
  /// silenciosa, o pior desfecho possível.
  estrito     Boolean         @default(true)
  /// Por que este cliente está neste provedor. Sem motivo, ninguém audita depois.
  motivo      String?
  decididoPor String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([workspaceId, clientId])
  @@index([workspaceId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  /// V2 (M3, aditiva): estado canonico derivado — cache auditado, nunca digitado.
