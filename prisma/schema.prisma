  @@index([projectId])
}

// ─── AI Run Logs ──────────────────────────────────────────────────────────────
// Tracks every department intelligence execution — provider used, fallback
// status, prompt/output summaries, and warnings. Persisted per workspace.

model AIRunLog {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId   String
  projectId      String?
  provider       String          @default("rule_based")
  model          String          @default("rule_based")
  status         String          @default("success")
  fallbackUsed   Boolean         @default(false)
  fallbackReason String?
  promptSummary  String?
  outputSummary  String?
  warnings       String          @default("[]")
  createdAt      DateTime        @default(now())

  // ── A CONTA: quem pediu, quanto consumiu, quanto custou ────────────────────
  // Acrescentado em 06/08/2026. Até aqui a tabela não tinha coluna de token nem
  // de custo E estava vazia em produção (nunca teve escritor). Ou seja: "quanto
  // custou este cliente este mês" não tinha resposta possível, nem retroativa.

  /// DE QUEM é a conta. Nulo quando a chamada não é de nenhum cliente (triagem
  /// de lead, radar, saúde do sistema) — e nulo é uma resposta legítima, não uma
  /// falta: "gasto sem dono" é um número que a agência precisa ver separado.
  clientId         String?
  /// QUEM pediu, dentro do departamento (o `ownerAgentId` do especialista).
  agentId          String?
  tokensEntrada    Int?
  tokensSaida      Int?
  /// USD estimado. NULO quando o modelo está fora da tabela de preço ou o
  /// provedor não devolveu `usage`. Nunca 0 nesses casos: zero afirmaria que a
  /// chamada foi de graça, e um modelo novo apareceria como economia.
  custoEstimadoUsd Float?
  /// Qual versão de `lib/ai/precos.ts` produziu o número acima. Sem isto, um mês
  /// calculado com a tabela velha é indistinguível de um calculado com a nova.
  custoTabela      String?
  duracaoMs        Int?
  /// O motivo da falha, quando `status != "success"`. Mensagem do NOSSO motor
  /// (já sanitizada) — nunca o corpo cru do provedor, que pode ecoar o prompt.
  erro             String?

  /// Log cresce para sempre e é sempre lido "os últimos N deste workspace".
  @@index([workspaceId, createdAt])
  @@index([projectId])
  /// O relatório de gasto é sempre "deste cliente, nesta janela".
  @@index([workspaceId, clientId, createdAt])
}

// ─── DEPARTAMENTO FINANCEIRO ──────────────────────────────────────────────────
//
// Pedido do CEO em 07/08/2026: "todos os projetos são de autoria da Dioli
// Digital. Então todos os custos de todos os projetos, e também o faturamento,
// tudo, eu vou colocar dentro do financeiro da agência."
//
// UM lançamento serve receita e custo. Duas tabelas separadas divergiriam de
// campo em campo (uma ganha `origem`, a outra não) e o DRE teria de somar duas
// formas diferentes do mesmo conceito.
//
// ── AS TRÊS COLUNAS QUE FAZEM ESTA TABELA VALER ALGUMA COISA ────────────────
//
//   `origem`   — de ONDE veio o número. Número sem procedência num DRE é o que
//                faz um dono decidir errado com cara de dado.
//   `natureza` — realizado ou estimado. Nunca se somam sem rótulo.
//   `centroDeCusto` — a qual projeto/produto da casa pertence, mesmo quando não
//                há linha de `Client` (Foocci, CityJobs, a própria Dioli).
//                É o que responde "este projeto se paga?" sem sumir na média.

model LancamentoFinanceiro {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// `receita` | `custo`
  tipo           String
  /// `mensalidade` `projeto` `ia` `midia` `ferramenta` `pessoal` `imposto` `outro`
  categoria      String
  descricao      String

  /// CENTAVOS, inteiro. Dinheiro em ponto flutuante é erro de arredondamento
  /// com nome de bug — e aqui o erro sai no DRE que o CEO lê.
  valorCentavos  Int
  moeda          String          @default("BRL")

  /// PROCEDÊNCIA: `manual` | `contrato` | `registro_de_ia` | `extrato` | `importado`.
  origem         String
  /// `realizado` | `estimado`. Estimativa nunca se mistura com realizado sem rótulo.
  natureza       String          @default("realizado")

  /// A que mês este lançamento pertence (regime de competência).
  competencia    DateTime

  clientId       String?
  projectId      String?
  /// Nome do projeto/produto da casa quando não existe linha de cliente.
  centroDeCusto  String?

  /// Quem lançou. `null` = importado por rotina, e isso é diferente de "ninguém".
  criadoPor      String?
  observacao     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  /// O DRE é sempre "deste workspace, neste período".
  @@index([workspaceId, competencia])
  @@index([workspaceId, clientId, competencia])
  @@index([workspaceId, centroDeCusto, competencia])
}

