// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model AgencyWorkspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users                User[]
  clients              Client[]
  projects             Project[]
  integrationConfigs   DbIntegrationConfig[]
  agentProviderConfigs DbAgentProviderConfig[]
  activityEvents       ActivityEvent[]
  aiRunLogs            AIRunLog[]
  metaConnections      MetaConnection[]
  marketInsights       MarketInsight[]
}

// ─── Users / Auth ─────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  // Roles: master | project_manager | social_staff | design_staff | ads_staff | client
  role         String          @default("master")
  workspaceId  String
  workspace    AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // For client users only — links to the Client they may access
  clientId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ─── Clients ──────────────────────────────────────────────────────────────────

model Client {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  email       String?
  phone       String?
  website     String?
  // Secure token for client portal access — replaces raw client ID in portal URL
  portalToken String          @unique @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projects     Project[]
  notices      ClientNotice[]
  brandBrain   BrandBrain?
  brandUpdates BrandUpdate[]
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Links a project back to the Brain request it was created from, so the
  // execution view can load the approved department canvases (BrainArtifact).
  clientRequestId      String?
  name                 String
  goal                 String?
  type                 String?
  stage                String          @default("briefing")
  priority             String          @default("medium")
  deadline             String?
  proposalStatus       String?
  proposalPricing      String?
  proposalScope        String?
  proposalSentAt       String?
  // JSON-encoded string array of assigned agent IDs
  agents               String          @default("[]")
  // Execução durável da produção (não depende mais do navegador): o motor marca
  // o progresso no banco; um cron recupera projetos travados.
  // executionStatus: idle | pending | running | done | failed
  executionStatus      String          @default("idle")
  executionRequestedAt DateTime?
  executionStartedAt   DateTime?
  executionFinishedAt  DateTime?
  executionAttempts    Int             @default(0)
  executionError       String?

  // ── A ESTEIRA: os três carimbos que fazem o projeto andar ──────────────────
  // São DECISÕES, por isso ficam gravadas. O resto da fase é DERIVADO do dado
  // real (lib/agency/esteira/fases.ts) — campo de status escrito à mão mente em
  // duas semanas. Estes três não são status: são momentos que aconteceram.
  //
  // O portão de direção: a produção inteira só dispara depois que o cliente
  // avaliza o caminho. Aprovar direção é barato; refazer um mês de produção não.
  directionApprovedAt DateTime?
  // O PM apresentou o pacote de UMA vez. Antes disso o cliente não recebe
  // entrega solta — agência com cinco bocas parece desorganizada.
  presentedAt         DateTime?
  // O aval final do cliente. A partir daqui, implementação e ciclo mensal.
  clientApprovedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliverables     Deliverable[]
  materialRequests MaterialRequest[]
  strategyRooms    StrategyRoom[]
  activityEvents   ActivityEvent[]
  tasks            Task[]
  timelineEvents   TimelineEvent[]
  briefings        Briefing[]
  cycles           Cycle[]
}

// ─── Ciclos ───────────────────────────────────────────────────────────────────

/// O CICLO MENSAL — onde a relação vitalícia acontece.
///
/// Um projeto que nunca fecha não é medível: nada é entregue de fato, nada é
/// comparado, o painel nunca fica verde. Por isso a operação contínua não é um
/// projeto infinito — é uma sequência de ciclos que nascem, entregam, medem e
/// fecham. É o que permite dizer "agosto foi melhor que julho", e é isso que
/// segura um cliente por anos.
/// Uma campanha de tráfego pago que ESTA agência criou na conta do cliente.
///
/// Existe porque dinheiro precisa de rastro. Sem esta tabela, "quem mandou
/// gastar R$ 40 por dia na conta da padaria?" não teria resposta — só um id
/// solto dentro da Meta. Aqui ficam o teto que o cliente aprovou, quem
/// autorizou ligar e quando.
model AdCampaign {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String?
  projectId      String?
  /// Conexão Meta usada. É por ela que se descobre em qual conta isto vive.
  connectionId   String
  /// "act_..." — a conta de anúncio do cliente.
  adAccountId    String
  /// O id da campanha dentro da Meta.
  externalId     String
  /// O conjunto e o anúncio. Uma campanha SEM estes dois não entrega nada — é
  /// um envelope com verba. Ficam aqui porque ativar a campanha sem subir os
  /// filhos junto deixa a conta com cara de ligada e gastando zero.
  adSetId        String?
  adId           String?
  /// Resumo legível do público, para o painel e o relatório. Nunca é a fonte
  /// da verdade da segmentação — essa vive dentro da Meta.
  audience       String?
  name           String
  objective      String
  dailyBudgetBRL Float
  /// O teto que o cliente aprovou POR ESCRITO, congelado no momento da criação.
  /// Congelado de propósito: se o teto mudar depois, o que foi criado ontem
  /// continua julgável pelo que valia ontem.
  approvedCapBRL Float
  /// paused | active | ended
  status         String    @default("paused")
  /// Quem mandou ligar. Nulo enquanto nunca foi ativada.
  activatedBy    String?
  activatedAt    DateTime?
  /// Quando o guardião de verba freou sozinho, e por quê. Campanha que gasta
  /// sem entregar é o erro que ninguém percebe até a fatura chegar.
  pausedByGuardAt DateTime?
  pausedReason   String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([projectId])
}

/// A conta do Google Meu Negócio de um cliente.
///
/// Existe separada da `MetaConnection` de propósito: o ciclo de vida é outro.
/// O token do Google EXPIRA em 1h e se renova por refresh token; o da Meta dura
/// 60 dias e não se renova sozinho. Enfiar os dois na mesma tabela obrigaria
/// todo leitor a saber de qual provedor aquela linha é antes de usá-la — e é
/// exatamente aí que se publica na conta errada.
model GoogleConnection {
  id                    String    @id @default(cuid())
  workspaceId           String
  /// Nulo = a conta da própria Dioli. Preenchido = a conta de um cliente.
  clientId              String?
  /// "locations/123456" — o id do local dentro do Google.
  locationName          String
  /// "accounts/987654" — a conta que administra o local.
  accountName           String
  /// Nome legível: "Padaria do João — Centro".
  title                 String    @default("")
  accessTokenEncrypted  String
  /// O refresh token é o que sustenta a conexão viva. Sem ele, a conta cai em
  /// uma hora e alguém precisa reconectar à mão — o oposto de automático.
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                String    @default("connected") // connected | expired | revoked | error
  /// Até quando já lemos avaliações. Sem isto, cada rodada reprocessaria o
  /// histórico inteiro e responderia avaliação de dois anos atrás.
  reviewsSyncedAt       DateTime?
  /// A política da API do Business Profile PROÍBE resposta automatizada a
  /// avaliação "sem o consentimento prévio e específico do usuário"
  /// (docs/plataformas/google/fontes/business-profile-api-politicas.md).
  /// Nulo = sem consentimento registrado → NENHUMA resposta sai sozinha,
  /// tudo vira rascunho escalado. Preenchido = quando o cliente autorizou.
  autoReplyConsentAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([workspaceId, locationName])
  @@index([clientId])
}

/// Uma avaliação do Google e o que a agência fez com ela.
///
/// Fica no banco porque responder avaliação é PÚBLICO e PERMANENTE: precisa de
/// rastro de quem respondeu o quê e quando, e de uma trava para não responder
/// duas vezes a mesma avaliação.
model GoogleReview {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String?
  connectionId   String
  /// O id da avaliação no Google. É a chave de idempotência.
  externalId     String
  reviewerName   String    @default("")
  starRating     Int       @default(0)
  comment        String    @default("")
  createdAtGoogle DateTime?
  /// pendente | respondida | escalada | ignorada
  status         String    @default("pendente")
  /// A resposta que a agência escreveu. Guardada mesmo quando escalada — é o
  /// rascunho que a gente mostra a quem vai decidir.
  reply          String?
  repliedAt      DateTime?
  /// Por que virou assunto de gente. Avaliação negativa nunca é respondida
  /// sozinha: resposta errada a cliente irritado é pública e permanente.
  escalatedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([connectionId, externalId])
  @@index([workspaceId, status])
}

model Cycle {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Competência do ciclo, sempre AAAA-MM. Um por mês, por projeto.
  reference   String
  /// aberto | entregue | fechado
  status      String    @default("aberto")
  startsOn    String
  endsOn      String
  /// O que este ciclo se comprometeu a entregar (JSON), congelado na abertura.
  planJson    String    @default("[]")
  /// Números do fechamento (JSON): o que foi medido no fim.
  resultsJson String    @default("{}")
  /// A leitura do ciclo em uma frase — o que melhorou, o que não.
  summary     String?
  /// Quando o pacote DESTE ciclo foi mostrado ao cliente. Por ciclo, não por
  /// projeto: o carimbo do projeto só serve ao pacote inicial, e sem este a
  /// entrega do mês 2 nunca chegaria a ser apresentada.
  presentedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, reference])
  @@index([projectId, status])
}

// ─── Avisos ao cliente ────────────────────────────────────────────────────────

/// O AVISO — a ponte entre "a esteira precisa de algo" e "o cliente ficou sabendo".
///
/// A esteira escreve no portal, mas o portal só existe se o cliente abrir. Sem
/// esta tabela, um pedido de material podia ficar semanas parado porque ninguém
/// avisou que ele existia — o projeto travado e a agência achando que a bola
/// estava com o cliente.
///
/// A regra: o aviso NUNCA se perde. Se houver canal automático configurado, ele
/// sai sozinho e o registro fica como comprovante. Se não houver, o aviso vira
/// FILA para o time disparar à mão — com o texto e o link já prontos, para não
/// depender de alguém escrever bem às pressas.
///
/// Isso resolve a restrição real do WhatsApp: fora da janela de 24h a Meta só
/// aceita template aprovado, e aprovação leva dias. Até lá o aviso sai pela mão
/// de gente, mas sai — e o sistema sabe se saiu.
model ClientNotice {
  id          String  @id @default(cuid())
  workspaceId String
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?

  /// direcao | material | entrega | ciclo
  kind String
  /// O que o cliente precisa saber, já redigido para ser lido por ele.
  body String
  /// O link do portal que resolve este aviso.
  link String?

  /// pendente | enviado | falhou | dispensado
  status     String    @default("pendente")
  /// whatsapp | email | manual | nenhum
  channel    String    @default("nenhum")
  /// Por que não saiu sozinho — para a equipe entender sem adivinhar.
  failReason String?
  sentAt     DateTime?
  /// Quem disparou, quando foi à mão.
  sentBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([clientId, status])
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  type            String
  status          String   @default("draft")
  revisionStatus  String?
  content         String?
  clientFeedback  String?
  lastFeedback    String?
  ownerAgentId    String?
  /// De que ciclo mensal esta entrega é. NULO = entrega do pacote inicial (o
  /// projeto, antes de virar rotina). É a chave que faz o mês 2 existir: sem
  /// ela a idempotência por especialista vale para sempre e a agência entrega
  /// uma vez só na vida do cliente.
  cycleId         String?
  version         Int      @default(1)
  // JSON-encoded revision history
  revisionHistory String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId, cycleId])
}

// ─── Material Requests ────────────────────────────────────────────────────────

/// O pedido de material que um agente faz ao cliente.
///
/// Regra da casa: o agente ABRE o pedido, o gerente de projeto CONSOLIDA e fala.
/// O cliente recebe uma mensagem só, com tudo que falta — nunca cinco agentes
/// pedindo coisas soltas em horários diferentes. Por isso o pedido guarda quem
/// pediu (para a equipe saber quem está travado) e quando foi enviado ao cliente
/// (para o PM não cobrar a mesma coisa duas vezes).
model MaterialRequest {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               String
  description        String
  status             String    @default("pending")
  /// Qual agente travou por falta deste material (a3, a2…).
  requestedByAgentId String?
  /// Nome legível de quem pediu — vai no resumo que o PM manda.
  requestedByLabel   String?
  /// Quando o PM incluiu este pedido na mensagem consolidada ao cliente.
  askedClientAt      DateTime?
  requestedAt        DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([projectId, status])
}

// ─── Brand Brain ─────────────────────────────────────────────────────────────

model BrandBrain {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brandName      String?
  tagline        String?
  primaryColor   String?
  secondaryColor String?
  typography     String?
  tone           String?
  values         String   @default("[]")
  targetAudience String?
  positioning    String?
  updatedAt      DateTime @updatedAt
}

// ─── Strategy Room ────────────────────────────────────────────────────────────

model StrategyRoom {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String?
  status       String   @default("generating")
  // Full StrategyRoom object (specialists, debate turns, consensus, executive
  // summary, synthesis) serialized as JSON — pragmatic single-column storage.
  analysisJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Briefings ─────────────────────────────────────────────────────────────

model Briefing {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId        String
  goal            String
  audience        String   @default("")
  keyMessage      String   @default("")
  deliverables    String   @default("")
  deadline        String   @default("")
  successCriteria String   @default("")
  notes           String?
  status          String   @default("pending_analysis")
  createdAt       DateTime @default(now())
}

// ─── Brand Updates ─────────────────────────────────────────────────────────
// Pending brand suggestions (client portal / manual / upload / parsed) queued
// before being applied to the client's BrandBrain.

model BrandUpdate {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field          String
  suggestedValue String
  currentValue   String?
  source         String   @default("manual")
  status         String   @default("pending")
  note           String?
  fileName       String?
  submittedAt    DateTime @default(now())
}

// ─── Brain Updates (learning loop) ────────────────────────────────────────────
// Department-scoped feedback proposals from approved deliverables / quality
// reviews / human edits. NEVER auto-applied — a human applies each one, which
// then mutates the actual BrandBrain. Distinct from BrandUpdate (portal/manual
// brand-field queue) — this captures the Brain's own learning signal.

model BrainUpdate {
  id              String    @id @default(cuid())
  clientRequestId String
  department      String
  fieldChanged    String // which brand brain field
  previousValue   String?
  proposedValue   String
  source          String // "approved_delivery" | "quality_review" | "human_edit"
  status          String    @default("pending") // "pending" | "applied" | "rejected"
  createdAt       DateTime  @default(now())
  appliedAt       DateTime?
}

// ─── Integration Configs ──────────────────────────────────────────────────────

model DbIntegrationConfig {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationId    String
  configured       Boolean         @default(false)
  selectedModel    String?
  configWorkspace  String?
  accountId        String?
  folder           String?
  webhookUrl       String?
  // API key storage — AES-256-GCM encrypted (see lib/security/crypto.ts).
  // apiKeyHint is a non-sensitive display string e.g. "sk-ant-…a1b2".
  apiKeyEncrypted  String?
  apiKeyHint       String?
  lastTestStatus   String          @default("not_run")
  lastTestAt       DateTime?
  lastTestMessage  String?
  lastConfiguredAt DateTime?

  @@unique([workspaceId, integrationId])
}

model DbAgentProviderConfig {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId          String
  selectedProvider String          @default("rule_based")
  selectedModel    String?

  @@unique([workspaceId, agentId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  agentId       String?
  status        String   @default("pending")
  dueDate       String?
  deliverableId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Timeline Events ──────────────────────────────────────────────────────────

model TimelineEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  label     String
  dept      String   @default("pm")
  detail    String?
  timestamp DateTime @default(now())
}

// ─── Activity Events ─────────────────────────────────────────────────────────

model ActivityEvent {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id])
  type        String
  message     String
  clientId    String?
  timestamp   DateTime        @default(now())
}

// ─── AI Run Logs ──────────────────────────────────────────────────────────────
// Tracks every department intelligence execution — provider used, fallback
// status, prompt/output summaries, and warnings. Persisted per workspace.

model AIRunLog {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId   String
  projectId      String?
  provider       String          @default("rule_based")
  model          String          @default("rule_based")
  status         String          @default("success")
  fallbackUsed   Boolean         @default(false)
  fallbackReason String?
  promptSummary  String?
  outputSummary  String?
  warnings       String          @default("[]")
  createdAt      DateTime        @default(now())
}

// ─── Continuous SDR Training V3 ───────────────────────────────────────────────

model TrainingBatch {
  id           String   @id @default(cuid())
  mode         String
  triggeredBy  String
  totalRuns    Int
  passCount    Int
  warningCount Int
  failCount    Int
  averageScore Int
  durationMs   Int
  createdAt    DateTime @default(now())

  runs DbSimulationRun[]
}

model DbSimulationRun {
  id               String         @id
  batchId          String?
  batch            TrainingBatch? @relation(fields: [batchId], references: [id])
  agentId          String
  scenarioOrigin   String
  scenarioSeed     String?
  scenarioName     String
  scenarioMetadata String         @default("{}")
  score            Int
  verdict          String
  transcript       String         @default("[]")
  finalScope       String?
  finalEstimate    String?
  sdrHandoff       String?
  issues           String         @default("[]")
  recommendations  String         @default("[]")
  engineVersion    String
  createdAt        DateTime       @default(now())
}

model DbAgentSuggestion {
  id              String    @id
  agentId         String
  title           String
  problem         String
  evidence        String
  suggestedChange String
  impact          String
  status          String    @default("pending")
  sourceRunIds    String    @default("[]")
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
}

model TrainingAlert {
  id            String    @id @default(cuid())
  agentId       String
  title         String
  message       String
  severity      String
  triggerType   String
  relatedRunIds String    @default("[]")
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

model BrainChangeRequest {
  id                  String    @id @default(cuid())
  agentId             String
  title               String
  sourceSuggestionIds String    @default("[]")
  proposedChange      String
  status              String    @default("pending_review")
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?
  appliedAt           DateTime?
  // Governance fields (Brain Director layer)
  source              String    @default("manual")
  department          String    @default("client-service-sdr")
  category            String    @default("department_logic")
  description         String    @default("")
  rationale           String    @default("")
  expectedImpact      String    @default("")
  riskLevel           String    @default("medium")
  requestedBy         String    @default("system")
  approvalRequiredBy  String    @default("brain_director")
  reviewedAt          DateTime?
  reviewNote          String?
}

// Brain version history — every applied change increments the version.
// Governance only: no runtime mutation of Brain logic yet.
model BrainVersion {
  id              String   @id @default(cuid())
  version         String   @unique
  summary         String
  changeRequestId String?
  createdAt       DateTime @default(now())
}

// ─── Foundation Sprint: Brain Pipeline Persistence ────────────────────────────

// DB-backed client request — source of truth for the real workflow.
// Zustand localStorage remains as labeled prototype/simulation layer.
model ClientRequestDb {
  id              String   @id @default(cuid())
  workspaceId     String?
  clientId        String?
  businessName    String
  segment         String   @default("")
  // JSON-encoded string arrays
  services        String   @default("[]")
  objectives      String   @default("[]")
  status          String   @default("new")
  source          String   @default("briefing")
  rawContext      String   @default("")
  briefingJson    String?
  sdrHandoffJson  String?
  attachmentsJson String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artifacts     BrainArtifact[]
  approvals     ApprovalRequest[]
  evidenceItems EvidenceItem[]
  portalAccess  PortalAccess[]
  messages      PortalMessage[]
}

// Client ↔ team conversation. One thread per Brain request (the project the
// client sees in their portal). authorRole distinguishes who wrote it; the
// read flags drive unread badges on each side.
model PortalMessage {
  id              String          @id @default(cuid())
  clientRequestId String
  clientRequest   ClientRequestDb @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  authorRole      String // "client" | "team"
  authorName      String          @default("")
  body            String
  readByTeam      Boolean         @default(false)
  readByClient    Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([clientRequestId, createdAt])
}

// A planned/scheduled social post — the unit of the universal Planner. One post
// composed once, targeting many networks, scheduled to a date. Surfaces on the
// agency planner (edit) and the client portal Social tab (read-only calendar).
model SocialPost {
  id              String    @id @default(cuid())
  workspaceId     String
  clientId        String?
  clientRequestId String? // links it to the client's portal thread
  caption         String    @default("")
  networks        String    @default("[]") // JSON array: instagram|facebook|tiktok|linkedin|youtube|pinterest
  format          String    @default("feed") // feed|reel|story|carousel|video
  pillar          String? // content pillar
  mediaUrl        String? // link to the creative (Drive/etc.) until native storage
  /// As telas do CARROSSEL, em JSON. Uma peça só com várias imagens — por isso
  /// não cabe em `mediaUrl`. Fica vazio em todo formato que não é carrossel.
  mediaUrlsJson   String  @default("[]")
  /// As telas descritas pelo especialista, uma por linha. É o que o gerador de
  /// arte usa para desenhar CADA tela — sem isso, um carrossel de 5 imagens
  /// sairia com 5 variações da mesma cena.
  scenesJson      String  @default("[]")
  scriptJson      String? // AI video/reel script (hook, scenes, cta, audio)
  scheduledFor    DateTime?
  status          String    @default("draft") // draft|scheduled|approved|published|failed
  // Quem gerou esta peça (o `Deliverable`) — é a chave de idempotência do
  // agendamento: entrega que já virou calendário não vira de novo.
  deliverableId   String?
  // Preenchidos na publicação. `externalPostId` é o que o relatório mensal usa
  // para pedir métricas à Meta; sem ele o report vira chute.
  externalPostId  String?
  permalink       String?
  publishedAt     DateTime?
  // Último motivo de falha, em linguagem de gente. Fica visível ao time em vez
  // de morrer no log do servidor.
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, scheduledFor])
  @@index([deliverableId])
  @@index([status, scheduledFor])
  @@index([clientRequestId])
}

// One record per department approval — persists canvas payload + gate + trace.
model BrainArtifact {
  id                String          @id @default(cuid())
  clientRequestId   String
  clientRequest     ClientRequestDb @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  department        String
  canvasId          String
  canvasJson        String
  qualityGateJson   String?
  cognitiveFlowJson String?
  version           Int             @default(1)
  status            String          @default("approved")
  approvedAt        DateTime        @default(now())
  approvedBy        String          @default("internal")
  createdAt         DateTime        @default(now())
}

// Formal approval flow — one record per department review cycle.
model ApprovalRequest {
  id              String          @id @default(cuid())
  clientRequestId String
  clientRequest   ClientRequestDb @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)
  artifactId      String?
  department      String
  requestedBy     String          @default("internal")
  status          String          @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  reviewNote      String?
  clientVisible   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments ApprovalComment[]
}

model ApprovalComment {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  authorName        String
  authorRole        String          @default("internal")
  body              String
  isClientVisible   Boolean         @default(false)
  createdAt         DateTime        @default(now())
}

// Evidence items tied to a request or artifact — persisted to DB.
model EvidenceItem {
  id              String           @id @default(cuid())
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id])
  artifactId      String?
  department      String
  type            String
  label           String
  valueJson       String           @default("{}")
  sourceUrl       String?
  createdAt       DateTime         @default(now())
}

// ─── Meta (Instagram / Facebook / WhatsApp) connected accounts ──────────────────
// One row per connected asset (an IG business account, a FB page, or a WhatsApp
// number). Populated by the OAuth flow in app/api/meta/*. The long-lived access
// token is AES-256-GCM encrypted at rest (see lib/security/crypto.ts) — exactly
// like AI keys in DbIntegrationConfig. The Meta APP credentials (App ID / App
// Secret) live in DbIntegrationConfig (integrationId "int-meta"), NOT here.
model MetaConnection {
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional: a connection can belong to a specific client, or to the agency
  // itself (clientId null = the agency's own accounts).
  clientId             String?
  // instagram | facebook | whatsapp
  platform             String
  // Human-readable label: IG handle, Page name, or WhatsApp display name.
  name                 String          @default("")
  // The platform's native id: IG Business Account id, FB Page id, or WABA
  // phone-number id — the id the Graph API publish/insights calls target.
  externalId           String
  // Long-lived access token — ENCRYPTED (iv:tag:ciphertext). Page tokens for
  // FB/IG do not expire; user tokens last ~60 days (see tokenExpiresAt).
  accessTokenEncrypted String
  tokenHint            String?
  tokenExpiresAt       DateTime?
  // Granted scopes/permissions (JSON array) and any extra platform metadata
  // (e.g. linked page id, business id) as JSON — avoids new columns per field.
  scopes               String          @default("[]")
  metaJson             String          @default("{}")
  status               String          @default("connected") // connected | expired | revoked | error
  connectedAt          DateTime        @default(now())
  lastSyncedAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, platform])
  @@index([clientId])
}

// WhatsApp conversation log — the single-inbox history. One row per message,
// inbound (client → agency) or outbound (agency → client), so the agency can
// read + reply from inside the system using ONE number. Populated inbound by
// the webhook and outbound by the reply endpoint.
model WhatsAppMessage {
  id              String   @id @default(cuid())
  workspaceId     String
  // The API phone-number-id this conversation belongs to (our number).
  phoneNumberId   String   @default("")
  // The client's WhatsApp id (their phone in wa_id form).
  contactWaId     String
  contactName     String?
  direction       String // "in" | "out"
  type            String   @default("text") // text | template | image | ...
  body            String   @default("")
  externalId      String? // Meta message id (wamid…) — for dedupe + status
  status          String? // sent | delivered | read | failed (outbound)
  clientRequestId String?
  timestamp       DateTime @default(now())

  @@index([workspaceId, contactWaId, timestamp])
  @@index([externalId])
}

// Outbox / dedupe ledger for WhatsApp notifications. One row per ActivityEvent
// we act on, so the poller never sends the same "whatsapp_notify" twice. Owned
// by the Meta integration (lib/integrations/meta/notifications.ts).
model WhatsAppOutbox {
  id                String   @id @default(cuid())
  workspaceId       String
  // The ActivityEvent this row was created for — unique so a re-run is a no-op.
  activityEventId   String   @unique
  kind              String   @default("proposal_sent")
  toPhone           String?
  status            String   @default("sent") // sent | failed | skipped
  externalMessageId String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, status])
}

// Granular, time-limited portal access per client request.
model PortalAccess {
  id              String           @id @default(cuid())
  token           String           @unique @default(cuid())
  clientRequestId String?
  clientRequest   ClientRequestDb? @relation(fields: [clientRequestId], references: [id])
  clientId        String?
  grantedAt       DateTime         @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  accessCount     Int              @default(0)
  createdAt       DateTime         @default(now())
}

// ─── Radar Dioli — biblioteca viva de tendências/atualizações de mercado ────
// O acervo que abastece TODOS os agentes (insumo) e as diretrizes da Qualidade.
// Governança: fonte "official" (a própria plataforma — Meta/TikTok/Google) entra
// ATIVA sem validação; "trend" (não-oficial) entra PENDENTE até um humano aprovar.
model MarketInsight {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Domínio: social | design | paid-traffic | analytics | seo | general
  domain      String
  // Tópico — chave de versionamento: nova entrada do mesmo tópico arquiva a antiga
  // (o "era assim → agora é assim").
  topic       String
  title       String
  // A diretriz vigente ("agora é assim") — o insumo que os agentes usam.
  guidance    String
  // official = da própria plataforma → entra ATIVA sem validação humana.
  // trend    = não-oficial → entra PENDENTE até validação humana.
  source      String          @default("trend")
  sourceName  String?
  sourceUrl   String?
  // active | pending | archived | rejected
  status      String          @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, domain, status])
  @@index([workspaceId, topic])
}

// ─── Mídia ────────────────────────────────────────────────────────────────────

/// O ARQUIVO. Foi o buraco mais caro encontrado no raio-X de 02/08/2026: até
/// aqui, nenhum byte de mídia era gravado em lugar nenhum — nem de entrada
/// (o vídeo que o cliente manda) nem de saída (a arte que a IA gera).
///
/// O que isso quebrava, em três serviços de uma vez: a dona do salão não tinha
/// por onde mandar os vídeos dela; o pet shop não tinha por onde mandar o logo;
/// e a imagem gerada pelo Design virava base64 dentro de uma coluna de texto do
/// banco (megabytes por peça) ou uma URL da OpenAI que expira em ~1 hora.
///
/// Desenho: o BYTE mora no volume persistente do Railway — o mesmo que já
/// guarda o banco, e que o `scripts/start.sh` trata como armazenamento durável.
/// Aqui mora só o registro. Nenhuma coluna guarda conteúdo binário.
///
/// A segurança é por DERIVAÇÃO, não por comparação: o dono é gravado aqui, e a
/// rota de download resolve o dono a partir do token do portal — nunca da URL.
/// O caminho em disco é derivado do id, nunca do nome que o cliente enviou, o
/// que mata travessia de diretório por construção.
model MediaAsset {
  id              String   @id @default(cuid())
  workspaceId     String
  /// O dono. Um dos dois sempre presente — é o que a rota de download confere.
  clientRequestId String?
  clientId        String?
  projectId       String?
  /// inbound = o cliente mandou · generated = a IA produziu · deliverable = vai ao cliente
  kind            String   @default("inbound")
  /// Nome original. É PII em potencial ("orcamento-joao-silva.pdf") — fica aqui,
  /// nunca em log.
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Impressão digital do conteúdo: permite detectar reenvio do mesmo arquivo.
  sha256          String
  /// Caminho relativo dentro do diretório de mídia. Derivado do id, nunca do
  /// nome enviado.
  storagePath     String
  /// Quem enviou, em linguagem de gente ("cliente", "Agente de Design").
  uploadedBy      String   @default("cliente")
  createdAt       DateTime @default(now())

  @@index([clientRequestId, createdAt])
  @@index([workspaceId, kind])
  @@index([sha256])
}
