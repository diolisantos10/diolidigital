// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model AgencyWorkspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users                User[]
  clients              Client[]
  projects             Project[]
  integrationConfigs   DbIntegrationConfig[]
  agentProviderConfigs DbAgentProviderConfig[]
  activityEvents       ActivityEvent[]
  aiRunLogs            AIRunLog[]
}

// ─── Users / Auth ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Roles: master | project_manager | social_staff | design_staff | ads_staff | client
  role         String   @default("master")
  workspaceId  String
  workspace    AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // For client users only — links to the Client they may access
  clientId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Clients ──────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  email       String?
  phone       String?
  website     String?
  // Secure token for client portal access — replaces raw client ID in portal URL
  portalToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects     Project[]
  brandBrain   BrandBrain?
  brandUpdates BrandUpdate[]
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  goal        String?
  type        String?
  stage       String   @default("briefing")
  priority    String   @default("medium")
  deadline    String?
  proposalStatus  String?
  proposalPricing String?
  proposalScope   String?
  proposalSentAt  String?
  // JSON-encoded string array of assigned agent IDs
  agents      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliverables     Deliverable[]
  materialRequests MaterialRequest[]
  strategyRooms    StrategyRoom[]
  activityEvents   ActivityEvent[]
  tasks            Task[]
  timelineEvents   TimelineEvent[]
  briefings        Briefing[]
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  type            String
  status          String   @default("draft")
  revisionStatus  String?
  content         String?
  clientFeedback  String?
  lastFeedback    String?
  ownerAgentId    String?
  version         Int      @default(1)
  // JSON-encoded revision history
  revisionHistory String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Material Requests ────────────────────────────────────────────────────────

model MaterialRequest {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  description String
  status      String    @default("pending")
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// ─── Brand Brain ─────────────────────────────────────────────────────────────

model BrandBrain {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brandName      String?
  tagline        String?
  primaryColor   String?
  secondaryColor String?
  typography     String?
  tone           String?
  values         String   @default("[]")
  targetAudience String?
  positioning    String?
  updatedAt      DateTime @updatedAt
}

// ─── Strategy Room ────────────────────────────────────────────────────────────

model StrategyRoom {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String?
  status       String   @default("generating")
  // Full StrategyRoom object (specialists, debate turns, consensus, executive
  // summary, synthesis) serialized as JSON — pragmatic single-column storage.
  analysisJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Briefings ─────────────────────────────────────────────────────────────

model Briefing {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId        String
  goal            String
  audience        String   @default("")
  keyMessage      String   @default("")
  deliverables    String   @default("")
  deadline        String   @default("")
  successCriteria String   @default("")
  notes           String?
  status          String   @default("pending_analysis")
  createdAt       DateTime @default(now())
}

// ─── Brand Updates ─────────────────────────────────────────────────────────
// Pending brand suggestions (client portal / manual / upload / parsed) queued
// before being applied to the client's BrandBrain.

model BrandUpdate {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field          String
  suggestedValue String
  currentValue   String?
  source         String   @default("manual")
  status         String   @default("pending")
  note           String?
  fileName       String?
  submittedAt    DateTime @default(now())
}

// ─── Integration Configs ──────────────────────────────────────────────────────

model DbIntegrationConfig {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationId    String
  configured       Boolean   @default(false)
  selectedModel    String?
  configWorkspace  String?
  accountId        String?
  folder           String?
  webhookUrl       String?
  lastTestStatus   String    @default("not_run")
  lastTestAt       DateTime?
  lastTestMessage  String?
  lastConfiguredAt DateTime?

  @@unique([workspaceId, integrationId])
}

model DbAgentProviderConfig {
  id               String  @id @default(cuid())
  workspaceId      String
  workspace        AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId          String
  selectedProvider String  @default("rule_based")
  selectedModel    String?

  @@unique([workspaceId, agentId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  agentId     String?
  status      String   @default("pending")
  dueDate     String?
  deliverableId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Timeline Events ──────────────────────────────────────────────────────────

model TimelineEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  label       String
  dept        String   @default("pm")
  detail      String?
  timestamp   DateTime @default(now())
}

// ─── Activity Events ─────────────────────────────────────────────────────────

model ActivityEvent {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  type        String
  message     String
  clientId    String?
  timestamp   DateTime @default(now())
}

// ─── AI Run Logs ──────────────────────────────────────────────────────────────
// Tracks every department intelligence execution — provider used, fallback
// status, prompt/output summaries, and warnings. Persisted per workspace.

model AIRunLog {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId   String
  projectId      String?
  provider       String          @default("rule_based")
  model          String          @default("rule_based")
  status         String          @default("success")
  fallbackUsed   Boolean         @default(false)
  fallbackReason String?
  promptSummary  String?
  outputSummary  String?
  warnings       String          @default("[]")
  createdAt      DateTime        @default(now())
}

// ─── Continuous SDR Training V3 ───────────────────────────────────────────────

model TrainingBatch {
  id           String            @id @default(cuid())
  mode         String
  triggeredBy  String
  totalRuns    Int
  passCount    Int
  warningCount Int
  failCount    Int
  averageScore Int
  durationMs   Int
  createdAt    DateTime          @default(now())

  runs         DbSimulationRun[]
}

model DbSimulationRun {
  id               String         @id
  batchId          String?
  batch            TrainingBatch? @relation(fields: [batchId], references: [id])
  agentId          String
  scenarioOrigin   String
  scenarioSeed     String?
  scenarioName     String
  scenarioMetadata String         @default("{}")
  score            Int
  verdict          String
  transcript       String         @default("[]")
  finalScope       String?
  finalEstimate    String?
  sdrHandoff       String?
  issues           String         @default("[]")
  recommendations  String         @default("[]")
  engineVersion    String
  createdAt        DateTime       @default(now())
}

model DbAgentSuggestion {
  id              String    @id
  agentId         String
  title           String
  problem         String
  evidence        String
  suggestedChange String
  impact          String
  status          String    @default("pending")
  sourceRunIds    String    @default("[]")
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
}

model TrainingAlert {
  id            String    @id @default(cuid())
  agentId       String
  title         String
  message       String
  severity      String
  triggerType   String
  relatedRunIds String    @default("[]")
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

model BrainChangeRequest {
  id                  String    @id @default(cuid())
  agentId             String
  title               String
  sourceSuggestionIds String    @default("[]")
  proposedChange      String
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?
  appliedAt           DateTime?
}

