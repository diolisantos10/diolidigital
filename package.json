{
  "name": "dioli-agency-os-1",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "build:dev": "npm run build && cp .env .next/standalone/.env 2>/dev/null || true && npm run db:provision:dev",
    "db:provision:dev": "DATABASE_URL=\"file:$(pwd)/.next/standalone/dev.db\" prisma db push --accept-data-loss && DATABASE_URL=\"file:$(pwd)/.next/standalone/dev.db\" node scripts/seed-db.mjs",
    "start": "sh scripts/start.sh",
    "start:dev": "sh scripts/start-dev.sh",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-db.mjs",
    "db:studio": "prisma studio",
    "check:production-safety": "tsx scripts/check-production-safety.ts",
    "diagnose:railway": "tsx scripts/diagnose-railway-env.ts"
  },
  "prisma": {
    "seed": "node scripts/seed-db.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
