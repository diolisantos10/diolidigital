{
  "name": "dioli-agency-os-1",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "tsx scripts/reivindicar.mts instalar-gancho --silencioso || true",
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "build:dev": "npm run build && cp .env .next/standalone/.env 2>/dev/null || true && npm run db:provision:dev",
    "db:provision:dev": "DATABASE_URL=\"file:$(pwd)/.next/standalone/dev.db\" prisma db push --accept-data-loss && DATABASE_URL=\"file:$(pwd)/.next/standalone/dev.db\" node scripts/seed-db.mjs",
    "start": "sh scripts/start.sh",
    "start:dev": "sh scripts/start-dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-db.mjs",
    "db:studio": "prisma studio",
    "cliente-falso": "tsx scripts/cliente-falso.mts",
    "sentinela": "tsx scripts/sentinela-do-deploy.mts",
    "distancia": "tsx scripts/distancia-do-deploy.mts",
    "portao": "tsx scripts/portao-do-deploy.mts",
    "redisparar": "tsx scripts/redisparar-deploy.mts",
    "medir-cache": "tsx scripts/medir-cache-do-sdr.mts",
    "deploy:emergencia": "tsx scripts/deploy-de-emergencia.mts",
    "raio-x": "tsx scripts/raio-x.ts",
    "causas": "tsx scripts/causas-de-refacao.mts",
    "prontidao": "tsx scripts/prontidao-de-publicacao.mts",
    "reconverter:jpeg": "tsx scripts/reconverter-pecas-para-jpeg.mts",
    "check:production-safety": "tsx scripts/check-production-safety.ts",
    "diagnose:railway": "tsx scripts/diagnose-railway-env.ts",
    "reivindicar": "tsx scripts/reivindicar.mts",
    "kit:espelhar": "tsx scripts/espelhar-kit.mts espelhar",
    "kit:carimbo": "tsx scripts/espelhar-kit.mts carimbo"
  },
  "prisma": {
    "seed": "node scripts/seed-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.6",
    "jose": "^6.2.3",
    "lucide-react": "^1.26.0",
    "next": "16.2.1",
    "playwright": "^1.61.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
